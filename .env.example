# Cognito (public values only — app client must have NO client secret for this static site)
PUBLIC_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile (use test key locally; production key on deploy)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: email validation Lambda Function URL
# Internal (SES + skip Turnstile): ./aws/scripts/setup-email-validate-test.sh
# Production (SES + Turnstile secret): TURNSTILE_SECRET_KEY=0x... ./aws/scripts/setup-email-validate.sh
PUBLIC_EMAIL_VALIDATE_URL=

# Orders API (place order / get order / inventory)
# Deploy: ./aws/scripts/setup-orders.sh
# Seed (CSV → Dynamo):   node aws/scripts/seed-inventory.mjs
# Sync  (Dynamo → CSV):  node aws/scripts/sync-inventory-to-csv.mjs
PUBLIC_ORDERS_API_URL=

# Protected admin API (CSV publishing, inventory management, notifications)
# Deploy: GITHUB_APP_ID=... GITHUB_INSTALLATION_ID=... GITHUB_OWNER=... \
#   GITHUB_REPO=... GITHUB_PRIVATE_KEY_SECRET_ID=... ./aws/scripts/setup-admin.sh
PUBLIC_ADMIN_API_URL=
