---
import "../styles/floating-cart.css";
---
<a
  href="/cart"
  class="floating-cart"
  id="floatingCart"
  hidden
  aria-label="Open cart"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="9" cy="21" r="1"/>
    <circle cx="20" cy="21" r="1"/>
    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
  </svg>
  <span class="floating-cart-badge" id="floatingCartBadge" data-count="0"></span>
</a>

<script>
  import { cartCount } from "../utils/cart";

  function onShopPath() {
    const p = window.location.pathname;
    return (
      p === "/merch" ||
      p.startsWith("/merch/") ||
      p === "/locker-rental" ||
      p.startsWith("/locker-rental/")
    );
  }

  function refresh() {
    const btn = document.getElementById("floatingCart");
    const badge = document.getElementById("floatingCartBadge");
    if (!btn || !badge) return;

    const show = onShopPath();
    btn.hidden = !show;
    if (!show) return;

    const n = cartCount();
    badge.dataset.count = String(n);
    badge.textContent = n > 0 ? String(n) : "";
    btn.setAttribute("aria-label", n > 0 ? `Open cart, ${n} items` : "Open cart");
    btn.classList.toggle("has-items", n > 0);
  }

  refresh();
  window.addEventListener("chbe-cart-updated", refresh);
  window.addEventListener("storage", refresh);
  document.addEventListener("astro:page-load", refresh);
</script>
