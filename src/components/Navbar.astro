---
import "../styles/navbar.css";
---
<nav class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="/" class="nav-brand">
      <img src="/logos/logo-round.png" alt="CHBE Council" class="nav-logo" />
      <img src="/logos/logo-text-white.png" alt="CHBE" class="nav-text-logo" />
    </a>
    <div class="nav-links">
      <!-- <a href="/">Home</a> -->
      <a href="/council">Council</a>
      <a href="/events">Events</a>
      <a href="/merch">Merch</a>
      <a href="/locker-rental">Lockers</a>
      <a href="/contact">Contact</a>
      <a href="/resources">Resources</a>
      <a href="/sign-in" class="nav-account disabled" aria-disabled="true">
        <svg class="account-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
        Sign In
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById("navbar") as HTMLElement;
  window.addEventListener("scroll", () => {
    navbar.classList.toggle("scrolled", window.scrollY > 80);
  }, { passive: true });
</script>