---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import NoticeBar from "../components/NoticeBar.astro";

export interface Props {
  title: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  /** Pass a string to show the notice bar above the navbar. Omit or comment out to hide. */
  notice?: string;
}
const { title, hideNav = false, hideFooter = false, notice } = Astro.props;
const showNotice = Boolean(notice) || Astro.slots.has("notice");
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/RocaTwo-Bl.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Telegraf.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Telegraf-UltraLight.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Telegraf-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Telegraf-UltraBold.otf" as="font" type="font/otf" crossorigin />
    <title>{title}</title>
  </head>
  <body class:list={[{ "has-notice": showNotice }]}>
    {notice ? (
      <NoticeBar message={notice} />
    ) : (
      <slot name="notice" />
    )}
    {!hideNav && <Navbar />}
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
