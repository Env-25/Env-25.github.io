---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { AUTH_CONFIG } from "../../utils/auth-config";
import "../../styles/auth.css";

const turnstileSiteKey = AUTH_CONFIG.turnstileSiteKey;
---

<BaseLayout title="Reset Password — UBC CHBE">
  <script is:inline>
    window.__chbeTurnstileToken = null;
    window.onTurnstileVerified = function (token) {
      window.__chbeTurnstileToken = token;
      var err = document.getElementById("captchaError");
      if (err) err.classList.remove("visible");
    };
    window.onTurnstileExpired = function () {
      window.__chbeTurnstileToken = null;
    };
    window.onTurnstileError = function () {
      window.__chbeTurnstileToken = null;
      var err = document.getElementById("captchaError");
      if (err) err.classList.add("visible");
    };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="auth-hero">
    <img src="/home/index-lower.jpg" alt="" class="auth-hero-bg" />
    <div class="auth-hero-overlay"></div>
    <div class="auth-hero-content">
      <h1 class="auth-hero-title">Reset Password</h1>
      <p class="auth-hero-sub">Recover your account</p>
    </div>
  </section>

  <section class="auth-section">
    <div class="auth-shell">
      <h2 class="auth-block-title">Reset your password</h2>
      <p class="auth-block-sub" id="stepHint">
        Enter your account email and we’ll send a verification code.
      </p>

      <form class="auth-form" id="resetForm" novalidate>
        <!-- Step 1: email -->
        <div class="auth-step" id="emailStep">
          <div class="form-field">
            <label for="resetEmail" class="form-label">
              Email <span class="required">*</span>
            </label>
            <input
              type="email"
              id="resetEmail"
              class="form-input"
              autocomplete="email"
              placeholder="your@email.com"
              required
            />
            <p class="field-error" id="emailError">Please enter a valid email address.</p>
          </div>

          <div class="form-field turnstile-wrap" id="turnstileWrap">
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-callback="onTurnstileVerified"
              data-expired-callback="onTurnstileExpired"
              data-error-callback="onTurnstileError"
              data-theme="light"
            ></div>
            <p class="field-error" id="captchaError">Please complete the CAPTCHA verification.</p>
          </div>

          <button type="button" class="form-submit" id="sendCodeBtn">
            <span class="btn-label">Send code</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
        </div>

        <!-- Step 2: code -->
        <div class="auth-step auth-hidden" id="codeStep" hidden>
          <div class="form-field">
            <label for="resetCode" class="form-label">
              Verification code <span class="required">*</span>
            </label>
            <input
              type="text"
              id="resetCode"
              class="form-input"
              inputmode="numeric"
              autocomplete="one-time-code"
              placeholder="Enter the code from your email"
            />
            <p class="field-error" id="codeError">Please enter the verification code.</p>
          </div>

          <div class="form-actions" id="codeActions">
            <button type="button" class="form-submit" id="verifyCodeBtn">
              <span class="btn-label">Verify code</span>
              <span class="btn-spinner" aria-hidden="true"></span>
            </button>
            <button type="button" class="form-secondary" id="resendBtn" disabled>
              Resend code
            </button>
          </div>
          <p class="form-hint" id="resendHint" hidden></p>
        </div>

        <!-- Step 3: new password -->
        <div class="auth-step auth-hidden" id="passwordStep" hidden>
          <div class="form-field">
            <label for="resetPassword" class="form-label">
              New password <span class="required">*</span>
            </label>
            <input
              type="password"
              id="resetPassword"
              class="form-input"
              autocomplete="new-password"
              placeholder="At least 8 characters"
            />
            <p class="form-hint">Use 8+ characters with upper, lower, a number, and a symbol (e.g. !@#).</p>
            <p class="field-error" id="passwordError">Please enter a valid password.</p>
          </div>

          <div class="form-field">
            <label for="resetPasswordConfirm" class="form-label">
              Confirm new password <span class="required">*</span>
            </label>
            <input
              type="password"
              id="resetPasswordConfirm"
              class="form-input"
              autocomplete="new-password"
              placeholder="Re-enter password"
            />
            <p class="field-error" id="passwordConfirmError">Passwords do not match.</p>
          </div>

          <button type="submit" class="form-submit" id="updatePasswordBtn">
            <span class="btn-label">Update password</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
        </div>

        <p class="form-feedback form-feedback--success" id="formSuccess" hidden></p>
        <p class="form-feedback form-feedback--error" id="formError" hidden></p>
      </form>

      <p class="auth-switch">
        Remember your password? <a href="/account/sign-in">Sign in</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    requestPasswordReset,
    confirmPasswordReset,
    getSessionProfile,
    logoutUser,
    cognitoErrorMessage,
    getResendRemainingSec,
    markResendSent,
  } from "../../utils/auth";
  import { isAuthConfigured } from "../../utils/auth-config";

  const form = document.getElementById("resetForm") as HTMLFormElement;
  const stepHint = document.getElementById("stepHint") as HTMLElement;
  const emailEl = document.getElementById("resetEmail") as HTMLInputElement;
  const codeEl = document.getElementById("resetCode") as HTMLInputElement;
  const passwordEl = document.getElementById("resetPassword") as HTMLInputElement;
  const confirmEl = document.getElementById("resetPasswordConfirm") as HTMLInputElement;

  const emailStep = document.getElementById("emailStep") as HTMLElement;
  const codeStep = document.getElementById("codeStep") as HTMLElement;
  const passwordStep = document.getElementById("passwordStep") as HTMLElement;
  const codeActions = document.getElementById("codeActions") as HTMLElement;

  const sendCodeBtn = document.getElementById("sendCodeBtn") as HTMLButtonElement;
  const verifyCodeBtn = document.getElementById("verifyCodeBtn") as HTMLButtonElement;
  const resendBtn = document.getElementById("resendBtn") as HTMLButtonElement;
  const updatePasswordBtn = document.getElementById(
    "updatePasswordBtn"
  ) as HTMLButtonElement;
  const turnstileWrap = document.getElementById("turnstileWrap") as HTMLElement;
  const captchaError = document.getElementById("captchaError") as HTMLElement;
  const resendHint = document.getElementById("resendHint") as HTMLElement;
  const formError = document.getElementById("formError") as HTMLElement;
  const formSuccess = document.getElementById("formSuccess") as HTMLElement;

  let verifiedCode = "";
  let resendTimer = 0;

  function resetTurnstile() {
    (window as any).__chbeTurnstileToken = null;
    captchaError.classList.remove("visible");
    (window as any).turnstile?.reset?.();
  }

  function show(el: HTMLElement) {
    el.hidden = false;
    el.classList.remove("auth-hidden");
  }

  function hide(el: HTMLElement) {
    el.hidden = true;
    el.classList.add("auth-hidden");
  }

  function clearFeedback() {
    formError.hidden = true;
    formSuccess.hidden = true;
  }

  function setLoading(btn: HTMLButtonElement, loading: boolean) {
    btn.classList.toggle("loading", loading);
    btn.disabled = loading;
  }

  function validateEmail(): boolean {
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim());
    emailEl.classList.toggle("error", !ok);
    document.getElementById("emailError")?.classList.toggle("visible", !ok);
    return ok;
  }

  function requireTurnstile(): boolean {
    const token = (window as any).__chbeTurnstileToken || null;
    captchaError.classList.toggle("visible", !token);
    return Boolean(token);
  }

  function validateCode(): boolean {
    const ok = codeEl.value.trim().length > 0;
    codeEl.classList.toggle("error", !ok);
    document.getElementById("codeError")?.classList.toggle("visible", !ok);
    return ok;
  }

  function validatePassword(): boolean {
    const v = passwordEl.value;
    const ok =
      v.length >= 8 &&
      /[A-Z]/.test(v) &&
      /[a-z]/.test(v) &&
      /\d/.test(v) &&
      /[^A-Za-z0-9]/.test(v);
    passwordEl.classList.toggle("error", !ok);
    document.getElementById("passwordError")?.classList.toggle("visible", !ok);
    return ok;
  }

  function validateConfirm(): boolean {
    const ok = confirmEl.value === passwordEl.value && confirmEl.value.length > 0;
    confirmEl.classList.toggle("error", !ok);
    document.getElementById("passwordConfirmError")?.classList.toggle("visible", !ok);
    return ok;
  }

  function updateResendUi() {
    const remaining = getResendRemainingSec();
    if (remaining > 0) {
      resendBtn.disabled = true;
      resendHint.hidden = false;
      resendHint.textContent = `You can resend a code in ${remaining}s.`;
      window.clearInterval(resendTimer);
      resendTimer = window.setInterval(() => {
        const left = getResendRemainingSec();
        if (left <= 0) {
          window.clearInterval(resendTimer);
          resendBtn.disabled = false;
          resendHint.hidden = true;
          return;
        }
        resendHint.textContent = `You can resend a code in ${left}s.`;
      }, 1000);
    } else {
      resendBtn.disabled = false;
      resendHint.hidden = true;
    }
  }

  function afterCodeSent() {
    markResendSent();
    updateResendUi();
    emailEl.readOnly = true;
    sendCodeBtn.hidden = true;
    hide(turnstileWrap);
    show(codeStep);
    stepHint.textContent = "Enter the verification code we sent to your email.";
    formSuccess.textContent =
      "If an account exists for that email, a verification code has been sent.";
    formSuccess.hidden = false;
    codeEl.focus();
  }

  async function sendCode() {
    clearFeedback();
    if (!isAuthConfigured()) {
      formError.textContent = "Auth is not configured yet.";
      formError.hidden = false;
      return;
    }
    if (!validateEmail()) return;
    if (!requireTurnstile()) return;

    setLoading(sendCodeBtn, true);
    try {
      await requestPasswordReset(emailEl.value.trim());
      afterCodeSent();
    } catch (err) {
      const name = (err as { name?: string }).name;
      // Avoid account enumeration
      if (name === "UserNotFoundException") {
        afterCodeSent();
        return;
      }
      console.error("Password reset send error:", err);
      formError.textContent = cognitoErrorMessage(err);
      formError.hidden = false;
      resetTurnstile();
    } finally {
      setLoading(sendCodeBtn, false);
    }
  }

  function verifyCodeStep() {
    clearFeedback();
    if (!validateCode()) return;
    verifiedCode = codeEl.value.trim();
    codeEl.readOnly = true;
    hide(codeActions);
    show(passwordStep);
    stepHint.textContent = "Choose a new password for your account.";
    formSuccess.textContent = "Code accepted. Set your new password below.";
    formSuccess.hidden = false;
    passwordEl.focus();
  }

  // Prefill email from ?email= or signed-in profile
  (async () => {
    const params = new URLSearchParams(window.location.search);
    const fromQuery = (params.get("email") || "").trim();
    if (fromQuery) {
      emailEl.value = fromQuery;
    } else if (isAuthConfigured()) {
      try {
        const profile = await getSessionProfile();
        if (profile?.email) emailEl.value = profile.email;
      } catch {
        /* ignore */
      }
    }
    updateResendUi();
  })();

  [emailEl, codeEl, passwordEl, confirmEl].forEach((el) => {
    el.addEventListener("input", () => {
      el.classList.remove("error");
      el.closest(".form-field")?.querySelector(".field-error")?.classList.remove("visible");
      clearFeedback();
    });
  });

  sendCodeBtn.addEventListener("click", () => void sendCode());
  resendBtn.addEventListener("click", () => {
    clearFeedback();
    emailEl.readOnly = false;
    sendCodeBtn.hidden = false;
    show(turnstileWrap);
    resetTurnstile();
    stepHint.textContent =
      "Complete the CAPTCHA, then click Send code to get a new verification code.";
  });
  verifyCodeBtn.addEventListener("click", () => verifyCodeStep());

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearFeedback();

    if (!verifiedCode) {
      formError.textContent = "Please verify your email code first.";
      formError.hidden = false;
      return;
    }
    if (![validatePassword(), validateConfirm()].every(Boolean)) return;

    setLoading(updatePasswordBtn, true);
    try {
      await confirmPasswordReset(
        emailEl.value.trim(),
        verifiedCode,
        passwordEl.value
      );
      try {
        await logoutUser();
      } catch {
        /* may not be signed in */
      }
      formSuccess.textContent = "Password updated. Redirecting to sign in…";
      formSuccess.hidden = false;
      window.setTimeout(() => {
        window.location.href = "/account/sign-in";
      }, 1200);
    } catch (err) {
      console.error("Password reset confirm error:", err);
      const name = (err as { name?: string }).name;
      if (name === "CodeMismatchException" || name === "ExpiredCodeException") {
        // Allow re-entry of code
        verifiedCode = "";
        hide(passwordStep);
        show(codeStep);
        show(codeActions);
        codeEl.readOnly = false;
        updateResendUi();
        stepHint.textContent = "That code was invalid or expired. Enter a new code.";
      }
      formError.textContent = cognitoErrorMessage(err);
      formError.hidden = false;
    } finally {
      setLoading(updatePasswordBtn, false);
    }
  });
</script>
