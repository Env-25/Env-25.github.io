---
import "../../styles/admin.css";
---

<main id="adminRoot" class="admin-page">
  <div class="admin-access-denied">
    <p>Checking access…</p>
  </div>
</main>

<script>
  import { getSessionProfile } from "../../utils/auth";
  import { fileToBase64, getAdmin, postAdmin } from "../../utils/admin";
  import { isAuthConfigured } from "../../utils/auth-config";

  type Workspace = "lockers" | "merch" | "notifications" | "members" | "events" | "resources" | "admin";
  type CsvRow = Record<string, string>;
  type ContentState = { workspace: Workspace; year?: string; headers: string[]; rows: CsvRow[]; caption?: string; originalInventory?: InventoryItem[] };
  type InventoryItem = { sku: string; kind: "locker" | "merch"; productId: string; label: string; name: string; color?: string; quantity: number };

  const root = document.getElementById("adminRoot")!;
  const workspaces: { id: Workspace; label: string; group: string }[] = [
    { id: "lockers", label: "Lockers", group: "lockers" },
    { id: "merch", label: "Merch", group: "merch" },
    { id: "notifications", label: "Notifications", group: "notifications" },
    { id: "members", label: "Members", group: "members" },
    { id: "events", label: "Events", group: "events" },
    { id: "resources", label: "Resources", group: "resources" },
    { id: "admin", label: "Admin", group: "admin" },
  ];
  const headers: Record<string, string[]> = {
    lockers: ["ID", "Name", "Desc", "Location", "Size", "Price", "Availability_Top", "Availability_Mid", "Availability_Bottom", "Rental_Term", "Lock_Included", "Cover_photo", "Add_photos"],
    merch: ["ID", "Name", "type_id", "Type", "Color", "Desc", "Price", "Sizes_Stock", "Cover_image", "Additional_images"],
    events: ["ID", "Name", "StartDate", "StartTime", "EndDate", "EndTime", "Location", "Image", "Email", "CalendarLink", "Desc"],
    members: ["ID", "Name", "Title", "Image", "Bio", "Contact", "LinkedIn"],
    resources: ["Title", "Description", "Href", "Icon", "Alt"],
  };
  const defaults: Record<string, CsvRow> = {
    lockers: { ID: "", Name: "", Desc: "", Location: "", Size: "", Price: "", Availability_Top: "0", Availability_Mid: "0", Availability_Bottom: "0", Rental_Term: "", Lock_Included: "NA", Cover_photo: "locker.jpg", Add_photos: "" },
    merch: { ID: "", Name: "", type_id: "", Type: "", Color: "", Desc: "", Price: "", Sizes_Stock: "", Cover_image: "product.jpg", Additional_images: "" },
    events: { ID: "", Name: "", StartDate: "", StartTime: "", EndDate: "", EndTime: "", Location: "", Image: "default.png", Email: "contact@chbe.ubc.ca", CalendarLink: "", Desc: "" },
    members: { ID: "", Name: "", Title: "", Image: "", Bio: "", Contact: "", LinkedIn: "" },
    resources: { Title: "", Description: "", Href: "", Icon: "", Alt: "" },
  };
  let profile: Awaited<ReturnType<typeof getSessionProfile>> = null;
  let state: ContentState | null = null;

  const escape = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char] || char));
  const message = (text: string, error = false) => `<div class="admin-message${error ? " admin-message--error" : ""}">${escape(text)}</div>`;

  function parseCsv(content: string) {
    const lines = content.replace(/^\uFEFF/, "").split(/\r?\n/).filter(Boolean);
    const cells = (line: string) => {
      const values: string[] = [];
      let current = "", quoted = false;
      for (let i = 0; i < line.length; i += 1) {
        const char = line[i];
        if (char === '"' && line[i + 1] === '"') { current += '"'; i += 1; }
        else if (char === '"') quoted = !quoted;
        else if (char === "," && !quoted) { values.push(current); current = ""; }
        else current += char;
      }
      values.push(current);
      return values;
    };
    const columns = lines.length ? cells(lines[0]).map((cell) => cell.trim()) : [];
    return { headers: columns, rows: lines.slice(1).map((line) => Object.fromEntries(columns.map((header, i) => [header, cells(line)[i] ?? ""]))) };
  }

  function csvValue(value: string) {
    return /[",\n\r]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
  }

  function serializeCsv(content: ContentState) {
    return [content.headers.join(","), ...content.rows.map((row) => content.headers.map((header) => csvValue(row[header] ?? "")).join(","))].join("\n") + "\n";
  }

  function modal(inner: string) {
    return `<div class="admin-modal" id="adminModal" role="dialog" aria-modal="true"><div class="admin-modal__dialog">${inner}</div></div>`;
  }

  function closeModal() {
    document.getElementById("adminModal")?.remove();
  }

  function showPublishNotice() {
    document.body.insertAdjacentHTML("beforeend", modal(`
      <h3>Changes are publishing</h3>
      <p class="admin-modal__copy">Your updates should be live in approximately 2 minutes, but may take up to 10 minutes. Please do not make the same changes again while publishing.</p>
      <div class="admin-modal__actions"><button class="admin-button" type="button" id="closePublishNotice">Okay</button></div>`));
    document.getElementById("closePublishNotice")?.addEventListener("click", closeModal);
  }

  function renderShell() {
    root.innerHTML = `
      <nav class="admin-nav"><a href="/" class="admin-nav__brand">CHBE ADMIN</a><a href="/" class="admin-nav__back">← Back to site</a></nav>
      <div class="admin-layout">
        <div class="admin-heading"><h1>Admin Console</h1><p class="admin-email">${escape(profile?.email)}</p></div>
        <div class="admin-body">
          <aside class="admin-menu">${workspaces.map((item) => `<button type="button" data-workspace="${item.id}">${item.label}</button>`).join("")}</aside>
          <section class="admin-panel" id="adminPanel"><p class="admin-status">Choose an area from the menu.</p></section>
        </div>
      </div>`;
    root.querySelectorAll<HTMLButtonElement>("[data-workspace]").forEach((button) => button.addEventListener("click", () => openWorkspace(button.dataset.workspace as Workspace)));
  }

  function showDenied() {
    const destination = profile?.isAdmin ? "/admin/" : "/";
    const label = profile?.isAdmin ? "Back to admin menu" : "Back to home";
    root.innerHTML = `<div class="admin-access-denied"><div><h1>Access denied</h1><p>Please contact the web team if this is a mistake.</p><a class="admin-button" href="${destination}" style="display:inline-flex;margin-top:1.5rem;">${label}</a></div></div>`;
  }

  function panel() {
    return document.getElementById("adminPanel")!;
  }

  function allowed(workspace: Workspace) {
    return Boolean(profile?.groups.includes(workspaces.find((item) => item.id === workspace)?.group || ""));
  }

  async function openWorkspace(workspace: Workspace) {
    if (!allowed(workspace)) { showDenied(); return; }
    window.location.hash = workspace;
    root.querySelectorAll<HTMLButtonElement>("[data-workspace]").forEach((button) => button.setAttribute("aria-current", String(button.dataset.workspace === workspace)));
    if (workspace === "notifications") return renderNotifications();
    if (workspace === "admin") return renderUserAdmin();
    await loadContentWorkspace(workspace);
  }

  async function loadContentWorkspace(workspace: Exclude<Workspace, "notifications" | "admin">, year = "2026") {
    panel().innerHTML = `<p class="admin-status">Loading ${escape(workspace)}…</p>`;
    try {
      const data = await getAdmin<{ content: string; caption?: string }>({ action: "content", workspace, ...(workspace === "members" ? { year } : {}) });
      const parsed = parseCsv(data.content);
      state = { workspace, year: workspace === "members" ? year : undefined, headers: parsed.headers.length ? parsed.headers : headers[workspace], rows: parsed.rows, caption: data.caption };
      if (workspace === "lockers" || workspace === "merch") {
        const inventory = await getAdmin<{ items: InventoryItem[] }>({ action: "inventory", kind: workspace === "lockers" ? "locker" : "merch" });
        state.originalInventory = inventory.items;
        mergeInventory(state, inventory.items);
      }
      renderContentWorkspace();
    } catch (error) {
      panel().innerHTML = message(error instanceof Error ? error.message : "Could not load this workspace.", true);
    }
  }

  function mergeInventory(content: ContentState, inventory: InventoryItem[]) {
    const stock = new Map(inventory.map((item) => [item.sku, Number(item.quantity)]));
    if (content.workspace === "lockers") {
      for (const row of content.rows) {
        for (const [label, field] of [["Top", "Availability_Top"], ["Mid", "Availability_Mid"], ["Bottom", "Availability_Bottom"]] as const) {
          const value = stock.get(`locker#${row.ID}#${label}`);
          if (value !== undefined) row[field] = String(value);
        }
      }
    }
    if (content.workspace === "merch") {
      for (const row of content.rows) {
        row.Sizes_Stock = String(row.Sizes_Stock || "").split("|").filter(Boolean).map((entry) => {
          const [size, amount] = entry.split(":");
          const value = stock.get(`merch#${row.ID}#${size?.trim()}`);
          return `${size?.trim() || ""}:${value === undefined ? amount || "0" : value}`;
        }).join("|");
      }
    }
  }

  function tableRow(content: ContentState, row: CsvRow) {
    return `<tr>${content.headers.map((header) => `<td${header === "ID" ? ' class="admin-table__identifier"' : ""}>${escape(row[header])}</td>`).join("")}<td><div class="admin-row-actions"><button type="button" class="admin-link-button" data-edit="${escape(row.ID || row.Title)}">Update</button><button type="button" class="admin-link-button admin-link-button--danger" data-delete="${escape(row.ID || row.Title)}">Delete</button></div></td></tr>`;
  }

  function tableRows(content: ContentState) {
    if (content.workspace !== "merch") return content.rows.map((row) => tableRow(content, row)).join("");
    const groups = new Map<string, CsvRow[]>();
    content.rows.forEach((row) => {
      const key = row.type_id || row.ID;
      groups.set(key, [...(groups.get(key) || []), row]);
    });
    return [...groups.entries()].map(([productId, rows]) =>
      `<tr><td colspan="${content.headers.length + 1}" style="background:rgba(114,166,145,.08)"><strong>Product ${escape(productId)}</strong> · ${escape(rows[0]?.Name || "")}</td></tr>${rows.map((row) => tableRow(content, row)).join("")}`
    ).join("");
  }

  function renderContentWorkspace(note = "") {
    if (!state) return;
    const content = state;
    const title = content.workspace === "members" ? `Members — ${content.year}` : content.workspace[0].toUpperCase() + content.workspace.slice(1);
    panel().innerHTML = `
      <h2>${escape(title)}</h2>
      <p class="admin-panel__intro">Fields remain read-only until Edit is selected. Changes only reach the public site after publishing.</p>
      ${note ? message(note) : ""}
      <div class="admin-toolbar">
        <div>${content.workspace === "members" ? `<select class="admin-search" id="yearSelect" aria-label="Council year"><option value="2026" ${content.year === "2026" ? "selected" : ""}>2026</option><option value="2025" ${content.year === "2025" ? "selected" : ""}>2025</option><option value="new">Create new year…</option></select>` : ""}</div>
        <div class="admin-row-actions"><button type="button" class="admin-secondary" id="addRecord">Add new</button><button type="button" class="admin-button" id="publishContent">Publish changes</button></div>
      </div>
      <div class="admin-table-wrap"><table class="admin-table"><thead><tr>${content.headers.map((header) => `<th${header === "ID" ? ' class="admin-table__identifier"' : ""}>${escape(header)}</th>`).join("")}<th>Actions</th></tr></thead><tbody>
        ${content.rows.length ? tableRows(content) : `<tr><td colspan="${content.headers.length + 1}">No entries yet.</td></tr>`}
      </tbody></table></div>
      ${content.workspace === "members" ? `<div class="admin-field admin-field--full" style="margin-top:1.5rem"><label for="caption">Left to right caption</label><textarea id="caption">${escape(content.caption || "")}</textarea></div>` : ""}`;
    document.getElementById("addRecord")?.addEventListener("click", () => editRecord(null));
    document.getElementById("publishContent")?.addEventListener("click", () => publishContent());
    panel().querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((button) => button.addEventListener("click", () => editRecord(content.rows.find((row) => (row.ID || row.Title) === button.dataset.edit) || null)));
    panel().querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((button) => button.addEventListener("click", () => deleteRecord(button.dataset.delete || "")));
    document.getElementById("caption")?.addEventListener("input", (event) => { if (state) state.caption = (event.target as HTMLTextAreaElement).value; });
    const yearSelect = document.getElementById("yearSelect") as HTMLSelectElement | null;
    yearSelect?.addEventListener("change", () => {
      if (yearSelect.value === "new") {
        const year = window.prompt("Enter the new four-digit council year:");
        if (year && /^\d{4}$/.test(year)) loadContentWorkspace("members", year);
        else yearSelect.value = content.year || "2026";
      } else loadContentWorkspace("members", yearSelect.value);
    });
  }

  function imageFieldName(content: ContentState) {
    return ({ lockers: "Cover_photo", merch: "Cover_image", events: "Image", members: "Image", resources: "Icon" } as Record<string, string>)[content.workspace];
  }

  function managedImageFields(content: ContentState): { cover: string; additional?: string; directory: string } | null {
    if (content.workspace === "lockers") return { cover: "Cover_photo", additional: "Add_photos", directory: "lockers" };
    if (content.workspace === "merch") return { cover: "Cover_image", additional: "Additional_images", directory: "merch" };
    if (content.workspace === "events") return { cover: "Image", directory: "events" };
    return null;
  }

  function imageUrl(directory: string, name: string) {
    return `/${directory}/images/${encodeURIComponent(name)}`;
  }

  function imageOption(directory: string, name: string, candidate: string, cover: string, additional: Set<string>, allowAdditional: boolean, disabled: boolean, localUrl?: string) {
    return `<article class="admin-image-option" data-image-candidate="${escape(candidate)}">
      <img src="${escape(localUrl || imageUrl(directory, name))}" alt="${escape(name)}" class="admin-image-option__preview">
      <p title="${escape(name)}">${escape(name)}</p>
      <div class="admin-image-option__controls">
        <label><input class="admin-image-control" type="radio" name="productCover" value="${escape(candidate)}" ${cover === candidate ? "checked" : ""} ${disabled ? "disabled" : ""}> Cover</label>
        ${allowAdditional ? `<label><input class="admin-image-control" type="checkbox" name="productAdditional" value="${escape(candidate)}" ${additional.has(candidate) ? "checked" : ""} ${disabled ? "disabled" : ""}> Additional</label>` : ""}
      </div>
    </article>`;
  }

  function productImageManager(content: ContentState, original: CsvRow, disabled: boolean) {
    const fields = managedImageFields(content)!;
    const hasAdditional = Boolean(fields.additional);
    return `<section class="admin-image-manager" aria-label="Image manager">
      <div><h4>${content.workspace === "events" ? "Event image" : "Product images"}</h4><p class="admin-panel__intro">${hasAdditional ? "Choose one cover image and any number of additional images." : "Choose the event cover image."} New files are only uploaded when selected below.</p></div>
      <div class="admin-image-grid" id="imageOptions"><p class="admin-panel__intro">Loading available images…</p></div>
      <div class="admin-field admin-field--full">
        <label for="imageUploads">Add new images</label>
        <input class="admin-image-control" id="imageUploads" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple ${disabled ? "disabled" : ""}>
        <span class="admin-panel__intro">Select files to preview them, then mark each as ${hasAdditional ? "cover or additional" : "the cover"} before saving.</span>
      </div>
    </section>`;
  }

  function sizeStockRow(size: string, quantity: string, disabled: boolean) {
    return `<tr>
      <td><input class="admin-size-stock-control" data-size-stock-size value="${escape(size)}" aria-label="Size" ${disabled ? "disabled" : ""}></td>
      <td><input class="admin-size-stock-control" data-size-stock-quantity type="number" min="0" step="1" value="${escape(quantity)}" aria-label="Stock" ${disabled ? "disabled" : ""}></td>
      <td><button class="admin-link-button admin-link-button--danger admin-size-stock-control" type="button" data-remove-size ${disabled ? "disabled" : ""}>Remove</button></td>
    </tr>`;
  }

  function sizeStockEditor(value: string, disabled: boolean) {
    const rows = String(value || "").split("|").filter(Boolean).map((entry) => {
      const [size, quantity] = entry.split(":");
      return sizeStockRow(size?.trim() || "", quantity?.trim() || "0", disabled);
    }).join("");
    return `<div class="admin-size-stock">
      <table><thead><tr><th>Size</th><th>Stock</th><th></th></tr></thead><tbody id="sizeStockRows">${rows}</tbody></table>
      <button class="admin-secondary admin-size-stock-control" type="button" id="addSizeStock" ${disabled ? "disabled" : ""}>Add size</button>
    </div>`;
  }

  function editableField(content: ContentState, header: string, original: CsvRow, disabled: boolean) {
    const wide = header === "Desc" || header === "Bio" || header === "Description" || (content.workspace === "merch" && header === "Sizes_Stock");
    if (content.workspace === "merch" && header === "Sizes_Stock") {
      return `<div class="admin-field admin-field--full"><label>Sizes and stock</label>${sizeStockEditor(original[header], disabled)}</div>`;
    }
    const control = header === "Desc" || header === "Bio" || header === "Description"
      ? `<textarea id="field-${escape(header)}" data-field="${escape(header)}" ${disabled ? "disabled" : ""}>${escape(original[header])}</textarea>`
      : `<input id="field-${escape(header)}" data-field="${escape(header)}" value="${escape(original[header])}" ${disabled ? "disabled" : ""}>`;
    return `<div class="admin-field${wide ? " admin-field--full" : ""}"><label for="field-${escape(header)}">${escape(header)}</label>${control}</div>`;
  }

  function editRecord(row: CsvRow | null) {
    if (!state) return;
    const content = state;
    const isNew = !row;
    const original = row ? { ...row } : { ...defaults[content.workspace], ...(content.workspace === "lockers" && content.rows[0] ? { Price: content.rows[0].Price } : {}), ...(content.workspace === "members" ? { ID: String(Math.max(0, ...content.rows.map((item) => Number(item.ID) || 0)) + 1) } : {}) };
    const productImages = managedImageFields(content);
    const imageField = imageFieldName(content);
    const editableFields = content.headers.filter((header) => !productImages || (header !== productImages.cover && header !== productImages.additional));
    document.body.insertAdjacentHTML("beforeend", modal(`
      <h3>${isNew ? "Add new entry" : "Update entry"}</h3>
      <div class="admin-fields">${editableFields.map((header) => editableField(content, header, original, !isNew)).join("")}</div>
      ${productImages ? productImageManager(content, original, !isNew) : imageField ? `<div class="admin-field" style="margin-top:1rem"><label for="imageUpload">Upload image</label><input id="imageUpload" type="file" accept="image/png,image/jpeg,image/webp,image/gif" ${isNew ? "" : "disabled"}><span class="admin-panel__intro">Images are published to the matching site folder.</span></div>` : ""}
      <div class="admin-modal__actions">${isNew ? "" : `<button class="admin-secondary" type="button" id="unlockRecord">Edit fields</button>`}<button class="admin-secondary" type="button" id="cancelRecord">Cancel</button><button class="admin-button" type="button" id="saveDraft">${isNew ? "Add draft" : "Save draft"}</button><button class="admin-button" type="button" id="publishRecord">Publish changes</button></div>`));
    const uploads = new Map<string, File>();
    const objectUrls: string[] = [];
    const renderLibrary = (assets: string[]) => {
      if (!productImages) return;
      const initialCover = `existing:${original[productImages.cover] || ""}`;
      const initialAdditional = new Set(String(productImages.additional ? original[productImages.additional] || "" : "").split("|").filter(Boolean).map((name) => `existing:${name.trim()}`));
      const names = [...new Set([...assets, original[productImages.cover], ...String(productImages.additional ? original[productImages.additional] || "" : "").split("|").filter(Boolean).map((name) => name.trim())].filter(Boolean))];
      const library = document.getElementById("imageOptions");
      if (library) library.innerHTML = names.length
        ? names.map((name) => imageOption(productImages.directory, name, `existing:${name}`, initialCover, initialAdditional, Boolean(productImages.additional), !isNew)).join("")
        : `<p class="admin-panel__intro">No existing images were found. Add a new image below.</p>`;
    };
    if (productImages) {
      getAdmin<{ assets: string[] }>({ action: "assets", workspace: content.workspace, year: content.year })
        .then(({ assets }) => renderLibrary(assets))
        .catch((error) => {
          const library = document.getElementById("imageOptions");
          if (library) library.innerHTML = message(error instanceof Error ? error.message : "Could not load the image library.", true);
        });
      document.getElementById("imageUploads")?.addEventListener("change", (event) => {
        const library = document.getElementById("imageOptions");
        const files = Array.from((event.target as HTMLInputElement).files || []);
        if (!library || !files.length) return;
        files.forEach((file) => {
          const id = `upload-${crypto.randomUUID()}`;
          uploads.set(id, file);
          const url = URL.createObjectURL(file);
          objectUrls.push(url);
          library.insertAdjacentHTML("beforeend", imageOption(productImages.directory, file.name, id, "", new Set(), Boolean(productImages.additional), false, url));
        });
        (event.target as HTMLInputElement).value = "";
      });
    }
    const sizeRows = document.getElementById("sizeStockRows");
    document.getElementById("addSizeStock")?.addEventListener("click", () => {
      sizeRows?.insertAdjacentHTML("beforeend", sizeStockRow("", "0", false));
    });
    sizeRows?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-remove-size]");
      button?.closest("tr")?.remove();
    });
    const readSizeStock = () => {
      const entries: string[] = [];
      const seen = new Set<string>();
      document.querySelectorAll<HTMLTableRowElement>("#sizeStockRows tr").forEach((entry) => {
        const size = entry.querySelector<HTMLInputElement>("[data-size-stock-size]")?.value.trim() || "";
        const quantityValue = entry.querySelector<HTMLInputElement>("[data-size-stock-quantity]")?.value || "";
        const quantity = Number(quantityValue);
        if (!size) {
          if (Number(quantityValue) > 0) throw new Error("Every stock row with stock needs a size.");
          return;
        }
        if (seen.has(size.toLowerCase())) throw new Error(`Size "${size}" is listed more than once.`);
        if (!Number.isInteger(quantity) || quantity < 0) throw new Error(`Stock for ${size} must be a whole number of zero or more.`);
        seen.add(size.toLowerCase());
        entries.push(`${size}:${quantity}`);
      });
      return entries.join("|");
    };
    const getValues = async () => {
      const next = { ...original, ...Object.fromEntries(editableFields.map((header) => [header, content.workspace === "merch" && header === "Sizes_Stock" ? readSizeStock() : String((document.querySelector(`[data-field="${CSS.escape(header)}"]`) as HTMLInputElement | HTMLTextAreaElement)?.value ?? "")])) } as CsvRow;
      if (productImages) {
        const coverCandidate = (document.querySelector('input[name="productCover"]:checked') as HTMLInputElement | null)?.value;
        const additionalCandidates = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="productAdditional"]:checked')).map((input) => input.value);
        if (!coverCandidate) throw new Error("Choose a cover image before saving.");
        const chosenUploads = new Set([coverCandidate, ...additionalCandidates].filter((candidate) => uploads.has(candidate)));
        const uploaded = new Map<string, string>();
        for (const candidate of chosenUploads) {
          const file = uploads.get(candidate)!;
          const response = await postAdmin<{ path: string }>({ action: "uploadAsset", workspace: content.workspace, year: content.year, filename: file.name, mime: file.type, base64: await fileToBase64(file) });
          uploaded.set(candidate, response.path.split("/").pop() || file.name);
        }
        const resolveCandidate = (candidate: string) => uploaded.get(candidate) || candidate.replace(/^existing:/, "");
        const cover = resolveCandidate(coverCandidate);
        next[productImages.cover] = cover;
        if (productImages.additional) next[productImages.additional] = [...new Set(additionalCandidates.map(resolveCandidate).filter((name) => name && name !== cover))].join("|");
      }
      const file = (document.getElementById("imageUpload") as HTMLInputElement | null)?.files?.[0];
      if (file && imageField) {
        const response = await postAdmin<{ path: string }>({ action: "uploadAsset", workspace: content.workspace, year: content.year, filename: file.name, mime: file.type, base64: await fileToBase64(file) });
        next[imageField] = response.path.split("/").pop() || next[imageField];
      }
      return next;
    };
    const save = async (publish: boolean) => {
      try {
        const next = await getValues();
        if (isNew) content.rows.push(next);
        else Object.assign(row!, next);
        if (content.workspace === "lockers") {
          content.rows.forEach((locker) => { locker.Price = next.Price; });
        }
        if (content.workspace === "merch") {
          const productType = next.type_id || next.ID;
          content.rows
            .filter((merch) => (merch.type_id || merch.ID) === productType)
            .forEach((merch) => { merch.Price = next.Price; });
        }
        objectUrls.forEach(URL.revokeObjectURL);
        closeModal();
        renderContentWorkspace();
        if (publish) await publishContent();
      } catch (error) {
        const actions = document.querySelector(".admin-modal__actions");
        actions?.insertAdjacentHTML("beforebegin", message(error instanceof Error ? error.message : "Could not save the entry.", true));
      }
    };
    document.getElementById("unlockRecord")?.addEventListener("click", () => {
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>("[data-field], #imageUpload, .admin-image-control, .admin-size-stock-control").forEach((field) => field.disabled = false);
      document.getElementById("unlockRecord")?.remove();
    });
    document.getElementById("cancelRecord")?.addEventListener("click", () => {
      objectUrls.forEach(URL.revokeObjectURL);
      closeModal();
    });
    document.getElementById("saveDraft")?.addEventListener("click", () => save(false));
    document.getElementById("publishRecord")?.addEventListener("click", () => save(true));
  }

  async function deleteRecord(key: string) {
    if (!state || !window.confirm("Delete this entry? This cannot be undone after publishing.")) return;
    state.rows = state.rows.filter((row) => (row.ID || row.Title) !== key);
    await publishContent();
  }

  function inventoryForContent(content: ContentState): InventoryItem[] {
    if (content.workspace === "lockers") {
      return content.rows.flatMap((row) => [["Top", "Availability_Top"], ["Mid", "Availability_Mid"], ["Bottom", "Availability_Bottom"]].map(([label, field]) => ({
        sku: `locker#${row.ID}#${label}`, kind: "locker" as const, productId: row.ID, label, name: row.Name, quantity: Math.max(0, Number(row[field]) || 0),
      })));
    }
    if (content.workspace === "merch") {
      return content.rows.flatMap((row) => String(row.Sizes_Stock || "").split("|").filter(Boolean).map((value) => {
        const [label, quantity] = value.split(":");
        return { sku: `merch#${row.ID}#${label?.trim()}`, kind: "merch" as const, productId: row.ID, label: label?.trim() || "", name: row.Name, color: row.Color, quantity: Math.max(0, Number(quantity) || 0) };
      }));
    }
    return [];
  }

  async function publishContent() {
    if (!state) return;
    const content = state;
    try {
      const nextInventory = inventoryForContent(content);
      const original = content.originalInventory || [];
      const nextKeys = new Set(nextInventory.map((item) => item.sku));
      const removed = original.filter((item) => !nextKeys.has(item.sku));
      await postAdmin({ action: "writeContent", workspace: content.workspace, year: content.year, content: serializeCsv(content), caption: content.caption || "" });
      if (removed.length) await postAdmin({ action: "deleteInventory", kind: content.workspace === "lockers" ? "locker" : "merch", items: removed });
      if (nextInventory.length) await postAdmin({ action: "saveInventory", kind: content.workspace === "lockers" ? "locker" : "merch", items: nextInventory });
      if (content.workspace === "lockers" || content.workspace === "merch") content.originalInventory = nextInventory;
      renderContentWorkspace();
      showPublishNotice();
    } catch (error) {
      renderContentWorkspace(error instanceof Error ? error.message : "Could not publish changes.");
      const note = panel().querySelector(".admin-message");
      note?.classList.add("admin-message--error");
    }
  }

  function emailPreview(html: string) {
    return `<!doctype html><html><body style="margin:0;background:#fdf9ef;color:#3a4b4a;font-family:Arial,Helvetica,sans-serif"><table width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:20px"><table width="100%" style="max-width:600px;background:#fff;border:1px solid #dce3df"><tr><td style="padding:24px;background:#3a4b4a;color:#fff;text-align:center"><img src="${window.location.origin}/logos/logo-text-white.png" alt="CHBE" width="150" style="display:block;margin:auto"><p style="margin:12px 0 0;color:#fff;font-weight:bold;letter-spacing:2px;font-size:11px">UBC CHBE COUNCIL</p></td></tr><tr><td style="padding:28px;font-size:16px;line-height:1.65">${html}</td></tr><tr><td style="padding:0 28px 28px;text-align:center"><span style="display:inline-block;padding:12px 18px;background:#3a4b4a;color:#fff;font-size:13px;font-weight:bold">Want to unsubscribe? Manage subscriptions</span><p style="font-size:12px">Contact us</p></td></tr></table></td></tr></table></body></html>`;
  }

  function emailImageOption(name: string, src: string, uploadId?: string) {
    return `<article class="admin-image-option">
      <img src="${escape(src)}" alt="${escape(name)}" class="admin-image-option__preview">
      <p title="${escape(name)}">${escape(name)}</p>
      <div class="admin-image-option__controls"><button class="admin-secondary" type="button" ${uploadId ? `data-upload-email-image="${escape(uploadId)}"` : `data-insert-email-image="${escape(src)}"`}>${uploadId ? "Upload & insert" : "Insert"}</button></div>
    </article>`;
  }

  function renderNotifications(note = "") {
    document.querySelector(".admin-rte-image-resize-handle")?.remove();
    panel().innerHTML = `
      <h2>Notifications</h2><p class="admin-panel__intro">Send email to subscribed users.</p>${note ? message(note) : ""}
      <div class="admin-email-grid"><div><div class="admin-field"><label for="mailSubject">Subject</label><input id="mailSubject" maxlength="160" placeholder="Email subject"></div><div class="admin-field" style="margin-top:1rem"><label for="mailBody">Message</label><div class="admin-rte-toolbar" aria-label="Message formatting"><button type="button" data-format="bold"><strong>B</strong></button><button type="button" data-format="italic"><em>I</em></button><button type="button" data-format="insertUnorderedList">List</button><button type="button" data-format="link">Link</button><button type="button" data-format="emailImages">Images</button></div><div id="mailBody" class="admin-rte" contenteditable="true" role="textbox" aria-multiline="true"><p>Write your announcement here.</p></div><p class="admin-panel__intro">Click an image in the message and drag its bottom-right handle to resize it.</p></div><section class="admin-image-manager" id="emailImages"><div><h4>Email images</h4><p class="admin-panel__intro">Choose an existing image to insert, or preview a new file before uploading and inserting it. Uploaded images are saved in the email image library.</p></div><div class="admin-field"><label for="emailImageUploads">Add new images</label><input id="emailImageUploads" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple></div><div class="admin-image-grid" id="emailImageOptions"><p class="admin-panel__intro">No email images have been uploaded yet.</p></div></section><div class="admin-audience"><label><input type="checkbox" value="general"> General</label><label><input type="checkbox" value="events"> Events</label><label><input type="checkbox" value="important"> Important</label></div><div class="admin-row-actions"><button class="admin-secondary" id="sendTest">Send test to me</button><button class="admin-button" id="sendNotification">Send notification</button></div></div><div><label class="admin-field"><span>Live preview</span><iframe title="Email preview" class="admin-preview" id="mailPreview" sandbox=""></iframe></label></div></div>`;
    const body = document.getElementById("mailBody")!;
    const preview = document.getElementById("mailPreview") as HTMLIFrameElement;
    const renderPreview = () => { preview.srcdoc = emailPreview(body.innerHTML.replace(/<script[\s\S]*?<\/script>/gi, "")); };
    const resizeHandle = document.createElement("button");
    resizeHandle.type = "button";
    resizeHandle.className = "admin-rte-image-resize-handle";
    resizeHandle.setAttribute("aria-label", "Drag to resize selected image");
    resizeHandle.hidden = true;
    document.body.append(resizeHandle);
    let selectedImage: HTMLImageElement | null = null;
    const positionResizeHandle = () => {
      if (!selectedImage?.isConnected) {
        resizeHandle.hidden = true;
        return;
      }
      const box = selectedImage.getBoundingClientRect();
      resizeHandle.style.left = `${box.right - 8}px`;
      resizeHandle.style.top = `${box.bottom - 8}px`;
      resizeHandle.hidden = false;
    };
    const selectImage = (image: HTMLImageElement | null) => {
      selectedImage?.classList.remove("admin-rte__selected-image");
      selectedImage = image;
      selectedImage?.classList.add("admin-rte__selected-image");
      positionResizeHandle();
    };
    const insertImage = (src: string) => {
      body.focus();
      document.execCommand("insertImage", false, src);
      selectImage(Array.from(body.querySelectorAll<HTMLImageElement>("img")).at(-1) || null);
      renderPreview();
    };
    body.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      selectImage(target.closest<HTMLImageElement>("img"));
    });
    body.addEventListener("error", (event) => {
      const image = event.target;
      if (!(image instanceof HTMLImageElement) || !body.contains(image)) return;
      image.classList.add("admin-rte__broken-image");
      positionResizeHandle();
    }, true);
    body.addEventListener("load", (event) => {
      const image = event.target;
      if (image instanceof HTMLImageElement) image.classList.remove("admin-rte__broken-image");
    }, true);
    body.addEventListener("input", () => {
      positionResizeHandle();
      renderPreview();
    });
    body.addEventListener("scroll", positionResizeHandle);
    resizeHandle.addEventListener("pointerdown", (event) => {
      if (!selectedImage) return;
      event.preventDefault();
      const image = selectedImage;
      const startX = event.clientX;
      const startWidth = image.getBoundingClientRect().width;
      const maxWidth = body.getBoundingClientRect().right - image.getBoundingClientRect().left;
      const resize = (moveEvent: PointerEvent) => {
        const width = Math.max(48, Math.min(maxWidth, Math.round(startWidth + moveEvent.clientX - startX)));
        image.setAttribute("width", String(width));
        image.removeAttribute("height");
        positionResizeHandle();
        renderPreview();
      };
      const stopResize = () => {
        window.removeEventListener("pointermove", resize);
        window.removeEventListener("pointerup", stopResize);
      };
      window.addEventListener("pointermove", resize);
      window.addEventListener("pointerup", stopResize);
    });
    panel().querySelectorAll<HTMLButtonElement>("[data-format]").forEach((button) => button.addEventListener("click", () => {
      body.focus();
      const format = button.dataset.format;
      if (format === "link") {
        const url = window.prompt("Enter the link URL:");
        if (!url) return;
        document.execCommand("createLink", false, url);
      } else if (format === "emailImages") {
        document.getElementById("emailImages")?.scrollIntoView({ behavior: "smooth", block: "center" });
      } else if (format) {
        document.execCommand(format, false);
      }
      renderPreview();
    }));
    const emailUploads = new Map<string, File>();
    const emailObjectUrls = new Map<string, string>();
    const emailOptions = document.getElementById("emailImageOptions")!;
    getAdmin<{ assets: string[] }>({ action: "assets", workspace: "notifications" })
      .then(({ assets }) => {
        emailOptions.innerHTML = assets.length
          ? assets.map((name) => emailImageOption(name, `${window.location.origin}/emails/images/${encodeURIComponent(name)}`)).join("")
          : `<p class="admin-panel__intro">No email images have been uploaded yet.</p>`;
      })
      .catch((error) => { emailOptions.innerHTML = message(error instanceof Error ? error.message : "Could not load email images.", true); });
    document.getElementById("emailImageUploads")?.addEventListener("change", (event) => {
      const files = Array.from((event.target as HTMLInputElement).files || []);
      files.forEach((file) => {
        const id = `email-${crypto.randomUUID()}`;
        emailUploads.set(id, file);
        const url = URL.createObjectURL(file);
        emailObjectUrls.set(id, url);
        emailOptions.insertAdjacentHTML("beforeend", emailImageOption(file.name, url, id));
      });
      (event.target as HTMLInputElement).value = "";
    });
    emailOptions.addEventListener("click", async (event) => {
      const target = event.target as Element;
      const insertButton = target.closest<HTMLButtonElement>("[data-insert-email-image]");
      if (insertButton) return insertImage(insertButton.dataset.insertEmailImage || "");
      const uploadButton = target.closest<HTMLButtonElement>("[data-upload-email-image]");
      if (!uploadButton) return;
      const id = uploadButton.dataset.uploadEmailImage || "";
      const file = emailUploads.get(id);
      if (!file) return;
      uploadButton.disabled = true;
      try {
        const response = await postAdmin<{ path: string }>({ action: "uploadAsset", workspace: "notifications", filename: file.name, mime: file.type, base64: await fileToBase64(file) });
        const src = `${window.location.origin}${response.path}`;
        insertImage(src);
        emailObjectUrls.get(id) && URL.revokeObjectURL(emailObjectUrls.get(id)!);
        uploadButton.closest(".admin-image-option")?.replaceWith(document.createRange().createContextualFragment(emailImageOption(response.path.split("/").pop() || file.name, src)));
        emailUploads.delete(id);
        emailObjectUrls.delete(id);
      } catch (error) {
        uploadButton.disabled = false;
        emailOptions.insertAdjacentHTML("beforebegin", message(error instanceof Error ? error.message : "Could not upload the image.", true));
      }
    });
    renderPreview();
    const send = async (test: boolean) => {
      const subject = (document.getElementById("mailSubject") as HTMLInputElement).value;
      const audiences = Array.from(panel().querySelectorAll<HTMLInputElement>(".admin-audience input:checked")).map((input) => input.value);
      try {
        const response = await postAdmin<{ message?: string; queued?: number }>({ action: "sendNotification", subject, html: body.innerHTML, audiences, test });
        renderNotifications(test ? response.message || "Test email queued." : `Queued ${response.queued || 0} email(s) for delivery at up to 6 per second.`);
      } catch (error) {
        renderNotifications(error instanceof Error ? error.message : "Could not send notification.");
        panel().querySelector(".admin-message")?.classList.add("admin-message--error");
      }
    };
    document.getElementById("sendTest")?.addEventListener("click", () => send(true));
    document.getElementById("sendNotification")?.addEventListener("click", () => send(false));
  }

  async function renderUserAdmin(note = "") {
    panel().innerHTML = `<h2>User administration</h2><p class="admin-panel__intro">Manage groups for existing Cognito users. Users must sign out and back in for updated access claims.</p>${note ? message(note) : ""}<div class="admin-toolbar"><input class="admin-search" id="userSearch" placeholder="Search by email"><button class="admin-button" id="findUsers">Search</button></div><div id="userResults"></div>`;
    const load = async () => {
      const results = document.getElementById("userResults")!;
      results.innerHTML = `<p class="admin-status">Loading users…</p>`;
      try {
        const query = (document.getElementById("userSearch") as HTMLInputElement).value;
        const response = await getAdmin<{ users: { username: string; email: string; name: string; groups: string[] }[]; availableGroups: string[] }>({ action: "users", query });
        results.innerHTML = response.users.map((user) => `<div class="admin-user"><div><strong>${escape(user.name || user.email)}</strong><br>${escape(user.email)}</div><div>${escape(user.username)}</div><div class="admin-group-toggle">${response.availableGroups.map((group) => { const active = user.groups.includes(group); return `<button class="admin-chip${active ? " active" : ""}" data-user="${escape(user.username)}" data-group="${group}" data-active="${String(active)}" aria-pressed="${String(active)}" title="${active ? `Remove ${group}` : `Add ${group}`}">${group}</button>`; }).join("")}</div></div>`).join("") || `<p class="admin-status">No users found.</p>`;
        results.querySelectorAll<HTMLButtonElement>(".admin-chip").forEach((button) => button.addEventListener("click", async () => {
          try {
            await postAdmin({ action: "groupUpdate", username: button.dataset.user || "", group: button.dataset.group || "", add: button.dataset.active !== "true" });
            await load();
          } catch (error) {
            renderUserAdmin(error instanceof Error ? error.message : "Could not update this group.");
          }
        }));
      } catch (error) {
        results.innerHTML = message(error instanceof Error ? error.message : "Could not load users.", true);
      }
    };
    document.getElementById("findUsers")?.addEventListener("click", load);
    document.getElementById("userSearch")?.addEventListener("keydown", (event) => { if (event.key === "Enter") load(); });
    await load();
  }

  (async () => {
    if (!isAuthConfigured()) {
      root.innerHTML = `<div class="admin-access-denied"><div><h1>Sign in required</h1><p>This console is not configured yet.</p></div></div>`;
      return;
    }
    profile = await getSessionProfile({ forceRefresh: true });
    if (!profile) {
      window.location.replace("/account/sign-in?next=/admin/");
      return;
    }
    if (!profile.isAdmin) { showDenied(); return; }
    renderShell();
    const requested = window.location.hash.slice(1) as Workspace;
    if (workspaces.some((item) => item.id === requested)) openWorkspace(requested);
  })();
</script>
