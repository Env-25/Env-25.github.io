---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTH_CONFIG } from "../utils/auth-config";
import "../styles/contact.css";

const turnstileSiteKey = AUTH_CONFIG.turnstileSiteKey;
const contactApiUrl = (import.meta.env.PUBLIC_CONTACT_API_URL as string | undefined)?.replace(/\/$/, "") || "";
---

<BaseLayout title="Contact — UBC CHBE">

  <script is:inline>
    window.__chbeTurnstileToken = null;
    window.onTurnstileVerified = function (token) {
      window.__chbeTurnstileToken = token;
      var err = document.getElementById("captchaError");
      if (err) err.classList.remove("visible");
    };
    window.onTurnstileExpired = function () {
      window.__chbeTurnstileToken = null;
    };
    window.onTurnstileError = function () {
      window.__chbeTurnstileToken = null;
      var err = document.getElementById("captchaError");
      if (err) err.classList.add("visible");
      if (window.turnstile && typeof window.turnstile.reset === "function") {
        try { window.turnstile.reset(); } catch (_) {}
      }
    };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="contact-hero">
    <img src="/home/index-lower.jpg" alt="" class="contact-hero-bg" />
    <div class="contact-hero-overlay"></div>
    <div class="contact-hero-content">
      <h1 class="contact-hero-title">Contact Us</h1>
      <p class="contact-hero-sub">We'd love to hear from you.</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-layout">

      <div class="contact-form-wrap">
        <h2 class="contact-block-title">Send a Message</h2>
        <p class="contact-block-sub">Fill out the form below and we'll get back to you as soon as possible.</p>

        <form class="contact-form" id="contactForm" novalidate>

          <div class="form-field">
            <label for="contactInquiry" class="form-label">
              Type of Inquiry <span class="required">*</span>
            </label>
            <select id="contactInquiry" name="inquiry_type" class="form-input form-select" required>
              <option value="" disabled selected>Select a topic…</option>
              <option value="general">General Inquiries / Lockers / Other</option>
              <option value="merch">Merch &amp; Orders</option>
              <option value="academic">Academic Support</option>
              <option value="2nd-year">2nd Year Representative</option>
              <option value="3rd-year">3rd Year Representative</option>
              <option value="4th-year">4th Year Representative</option>
              <option value="sponsorship">Sponsorship</option>
            </select>
            <p class="field-error" id="inquiryError">Please select a type of inquiry.</p>
          </div>

          <div class="form-field">
            <label for="contactName" class="form-label">
              Name <span class="required">*</span>
            </label>
            <input
              type="text" id="contactName" name="from_name"
              class="form-input" placeholder="Your full name"
              autocomplete="name" required
            />
            <p class="field-error" id="nameError">Please enter your name.</p>
          </div>

          <div class="form-field">
            <label for="contactEmail" class="form-label">
              Email <span class="required">*</span>
            </label>
            <input
              type="email" id="contactEmail" name="from_email"
              class="form-input" placeholder="your@email.com"
              autocomplete="email" required
            />
            <p class="field-error" id="emailError">Please enter a valid email address.</p>
          </div>

          <div class="form-field">
            <label for="contactSubject" class="form-label">
              Subject <span class="required">*</span>
            </label>
            <input
              type="text" id="contactSubject" name="subject"
              class="form-input" placeholder="What is this regarding?"
              required
            />
            <p class="field-error" id="subjectError">Please enter a subject.</p>
          </div>

          <div class="form-field">
            <label for="contactMessage" class="form-label">
              Message <span class="required">*</span>
            </label>
            <textarea
              id="contactMessage" name="message"
              class="form-input form-textarea"
              placeholder="Write your message here…"
              rows="6" required
            ></textarea>
            <p class="field-error" id="messageError">Please enter a message.</p>
          </div>

          <div class="form-field turnstile-wrap">
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-callback="onTurnstileVerified"
              data-expired-callback="onTurnstileExpired"
              data-error-callback="onTurnstileError"
              data-theme="light"
            ></div>
            <p class="field-error" id="captchaError">Please complete the CAPTCHA verification.</p>
          </div>

          <button type="submit" class="form-submit" id="submitBtn">
            <span class="btn-label">Send Message</span>
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>

          <p class="form-feedback form-feedback--success" id="formSuccess" hidden>
            ✓ Message sent! We'll be in touch soon.
          </p>
          <p class="form-feedback form-feedback--error" id="formError" hidden>
            Something went wrong — please try again or email us directly.
          </p>

        </form>
      </div>

      <div class="contact-directory">
        <h2 class="contact-block-title">Get in Touch Directly</h2>
        <p class="contact-block-sub">Reach out to the right person for your enquiry.</p>

        <div class="contact-cards">

          <div class="contact-card">
            <div class="contact-card-icon">
              <img src="/contact/general.png" alt="User Icon" class="contact-card-svg" />
            </div>
            <div class="contact-card-info">
              <p class="contact-card-role">General / Lockers / Other</p>
              <p class="contact-card-name">VP Internal</p>
              <a href="mailto:chbevpinternal@gmail.com" class="contact-card-email">chbevpinternal@gmail.com</a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon">
              <img src="/contact/merch.png" alt="Merch Icon" class="contact-card-svg" />
            </div>
            <div class="contact-card-info">
              <p class="contact-card-role">Merch &amp; Orders</p>
              <p class="contact-card-name">Communications Team</p>
              <a href="mailto:communications@chbecouncil.com" class="contact-card-email">communications@chbecouncil.com</a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon">
              <img src="/contact/academic.png" alt="Academic Icon" class="contact-card-svg" />
            </div>
            <div class="contact-card-info">
              <p class="contact-card-role">Academic Support</p>
              <p class="contact-card-name">Academic Committee</p>
              <a href="mailto:chbeacademics@chbecouncil.com" class="contact-card-email">chbeacademics@chbecouncil.com</a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon">
              <img src="/contact/representative.png" alt="Year Rep Icon" class="contact-card-svg" />
            </div>
            <div class="contact-card-info">
              <p class="contact-card-role">Year Representatives</p>
              <p class="contact-card-name">2nd / 3rd / 4th Year Reps</p>
              <a href="mailto:2ndyearrep@chbecouncil.com" class="contact-card-email">2ndyearrep@chbecouncil.com</a>
              <a href="mailto:3rdyearrep@chbecouncil.com" class="contact-card-email">3rdyearrep@chbecouncil.com</a>
              <a href="mailto:4thyearrep@chbecouncil.com" class="contact-card-email">4thyearrep@chbecouncil.com</a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon">
              <img src="/contact/sponsorship.png" alt="Sponsorship Icon" class="contact-card-svg" />
            </div>
            <div class="contact-card-info">
              <p class="contact-card-role">Sponsorship</p>
              <p class="contact-card-name">UBC Envision</p>
              <a href="mailto:ubcenvision@gmail.com" class="contact-card-email">ubcenvision@gmail.com</a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<script define:vars={{ contactApiUrl }}>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const inquiryEl = document.getElementById("contactInquiry") as HTMLSelectElement;
  const nameEl = document.getElementById("contactName") as HTMLInputElement;
  const emailEl = document.getElementById("contactEmail") as HTMLInputElement;
  const subjectEl = document.getElementById("contactSubject") as HTMLInputElement;
  const messageEl = document.getElementById("contactMessage") as HTMLTextAreaElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const captchaError = document.getElementById("captchaError")!;
  const formSuccess = document.getElementById("formSuccess") as HTMLElement;
  const formError = document.getElementById("formError") as HTMLElement;

  function turnstileToken(): string | null {
    return (window as any).__chbeTurnstileToken || null;
  }

  function validate(el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): boolean {
    let invalid = el.value.trim() === "";
    if (!invalid && (el as HTMLInputElement).type === "email") {
      invalid = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value);
    }
    el.classList.toggle("error", invalid);
    el.closest(".form-field")?.querySelector(".field-error")?.classList.toggle("visible", invalid);
    return !invalid;
  }

  function clearError(el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
    el.classList.remove("error");
    el.closest(".form-field")?.querySelector(".field-error")?.classList.remove("visible");
  }

  inquiryEl.addEventListener("change", () => clearError(inquiryEl));
  inquiryEl.addEventListener("blur", () => validate(inquiryEl));
  nameEl.addEventListener("blur", () => validate(nameEl));
  emailEl.addEventListener("blur", () => validate(emailEl));
  subjectEl.addEventListener("blur", () => validate(subjectEl));
  messageEl.addEventListener("blur", () => validate(messageEl));
  [nameEl, emailEl, subjectEl, messageEl].forEach((el) =>
    el.addEventListener("input", () => clearError(el))
  );

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const fieldsOk = [
      validate(inquiryEl),
      validate(nameEl),
      validate(emailEl),
      validate(subjectEl),
      validate(messageEl),
    ].every(Boolean);

    const token = turnstileToken();
    if (!token) captchaError.classList.add("visible");
    else captchaError.classList.remove("visible");

    if (!fieldsOk || !token) return;

    if (!contactApiUrl) {
      formError.textContent = "Contact form is not configured yet. Please email us directly.";
      formError.hidden = false;
      return;
    }

    submitBtn.classList.add("loading");
    submitBtn.disabled = true;
    formSuccess.hidden = true;
    formError.hidden = true;

    try {
      const res = await fetch(`${contactApiUrl}/`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiryType: inquiryEl.value,
          name: nameEl.value.trim(),
          email: emailEl.value.trim(),
          subject: subjectEl.value.trim(),
          message: messageEl.value.trim(),
          turnstileToken: token,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data.error || "Could not send your message.");
      }

      formSuccess.hidden = false;
      form.reset();
      (window as any).__chbeTurnstileToken = null;
      (window as any).turnstile?.reset?.();
    } catch (err: any) {
      console.error("Contact send error:", err);
      formError.textContent = err?.message || "Something went wrong — please try again or email us directly.";
      formError.hidden = false;
      (window as any).__chbeTurnstileToken = null;
      (window as any).turnstile?.reset?.();
    } finally {
      submitBtn.classList.remove("loading");
      submitBtn.disabled = false;
    }
  });
</script>
