---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMembers, getLeftToRightText, nameToSlug } from "../../utils/council";

const year = "2026";
const members = getMembers(year);
const fromLeftToRight = getLeftToRightText(year);

import "../../styles/council.css";
---
<BaseLayout title="Council — UBC CHBE">

  <!-- Hero -->
  <section class="council-hero">
    <img src="/home/index-lower.jpg" alt="" class="council-hero-bg" />
    <div class="council-hero-overlay"></div>
    <div class="council-hero-content">
      <h1 class="council-hero-title">CHBE Council</h1>
      <p class="council-hero-tagline">Meet the Team</p>
      <div class="year-row">
        <select class="year-select" id="yearSelect" autocomplete="off">
          <option value="2026" selected>2026</option>
          <option value="2025">2025</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Group Photo -->
  <section class="group-photo-section">
    <img
      src={`/council/${year}/group.jpg`}
      alt={`CHBE Council ${year} group photo`}
      class="group-photo"
      id="groupPhoto"
      loading="eager"
    />
    <p class="group-photo-caption">
      <span class="caption-label">From left to right —</span>
      <span id="captionNames">{fromLeftToRight}</span>
    </p>
  </section>

  <!-- Member Grid -->
  <section class="council-section">
    <div class="council-grid" id="councilGrid">
      {members.map((member) => (
        <a
          href={`/council/${year}/${nameToSlug(member.Name)}`}
          class="council-card"
          data-name={member.Name}
          data-title={member.Title}
        >
          <p class="card-name">{member.Name}</p>
          <p class="card-title">{member.Title}</p>
        </a>
      ))}
    </div>
    <p class="no-results" id="noResults" hidden>No members found for this year.</p>
  </section>

</BaseLayout>

<script>
  const yearSelect = document.getElementById("yearSelect") as HTMLSelectElement;
  const grid = document.getElementById("councilGrid")!;
  const groupPhoto = document.getElementById("groupPhoto") as HTMLImageElement;
  const captionNames = document.getElementById("captionNames")!;
  const noResults = document.getElementById("noResults")!;

  function nameToSlug(name: string): string {
    return name.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");
  }

  function parseCSV(text: string): Record<string, string>[] {
    const lines = text.trim().split("\n");
    const headers = lines[0].split(",").map((h) => h.trim().replace(/^"|"$/g, ""));
    return lines.slice(1).map((line) => {
      const fields: string[] = [];
      let current = "";
      let inQuotes = false;
      for (const ch of line) {
        if (ch === '"') { inQuotes = !inQuotes; }
        else if (ch === "," && !inQuotes) { fields.push(current.trim()); current = ""; }
        else { current += ch; }
      }
      fields.push(current.trim());
      const obj: Record<string, string> = {};
      headers.forEach((h, i) => { obj[h] = (fields[i] ?? "").replace(/^"|"$/g, ""); });
      return obj;
    });
  }

  async function loadYear(year: string) {
    try {
      const res = await fetch(`/council/${year}/members.csv`);
      if (!res.ok) throw new Error("Not found");
      const text = await res.text();
      const members = parseCSV(text);

      // Update group photo
      groupPhoto.src = `/council/${year}/group.jpg`;
      groupPhoto.alt = `CHBE Council ${year} group photo`;

      // Update caption
      const leftToRightRes = await fetch(`/council/${year}/leftToRight.txt`);
      captionNames.textContent = leftToRightRes.ok
        ? (await leftToRightRes.text()).trim()
        : members.map((m) => m.Name).join(", ");

      // Re-render grid
      if (members.length === 0) {
        grid.innerHTML = "";
        noResults.hidden = false;
        return;
      }

      noResults.hidden = true;
      grid.innerHTML = members
        .map((m) => {
          const slug = nameToSlug(m.Name);
          // ✅ Year is now included in the href
          return `<a href="/council/${year}/${slug}" class="council-card" data-name="${m.Name}" data-title="${m.Title}">
            <p class="card-name">${m.Name}</p>
            <p class="card-title">${m.Title}</p>
          </a>`;
        })
        .join("");
    } catch {
      grid.innerHTML = "";
      captionNames.textContent = "";
      noResults.hidden = false;
    }
  }

  yearSelect.value = "2026";
  yearSelect.addEventListener("change", () => loadYear(yearSelect.value));
</script>