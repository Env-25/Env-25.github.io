---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEvents } from "../../utils/events";
import "../../styles/events.css";

let events: import("../../utils/events").ChbeEvent[] = [];
let loadError = false;

try {
  events = getEvents().filter((e) => e.Name && e.Name.trim() !== "");
} catch {
  loadError = true;
}

function parseDate(s: string) { return new Date(s); }

const sorted = [...events].sort(
  (a, b) => parseDate(a.Date).getTime() - parseDate(b.Date).getTime()
);

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = sorted.filter((e) => parseDate(e.Date) >= today);
const spotlight = upcoming[0] ?? null;

const spotlightIndex = spotlight
  ? sorted.findIndex((e) => e.slug === spotlight.slug)
  : 0;

function mapsUrl(loc: string) {
  return `https://maps.google.com/?q=${encodeURIComponent(loc)}`;
}

const calEventsData = sorted.map((e) => ({
  name: e.Name,
  date: e.Date,
  time: e.Time,
  slug: e.slug,
}));
---
<BaseLayout title="Events — UBC CHBE">

  <!-- Hero -->
  <section class="events-hero">
    <img src="/home/index-lower.jpg" alt="" class="events-hero-bg" />
    <div class="events-hero-overlay"></div>
    <div class="events-hero-content">
      <h1 class="events-hero-title">CHBE Events</h1>
      <p class="events-hero-tagline">Your community, your calendar</p>
      <div class="events-hero-actions">
        <button class="events-action-btn" disabled title="Coming soon">
          + Subscribe to Calendar
        </button>
        <button class="events-action-btn" disabled title="Coming soon">
          ✉ Subscribe to Email Updates
        </button>
      </div>
    </div>
  </section>

  {loadError || events.length === 0 ? (
    <section class="events-empty-section">
      <div class="events-empty">
        <p class="empty-title">No upcoming events.</p>
        <p class="empty-sub">Check back regularly — we're always planning something new.</p>
      </div>
    </section>
  ) : (
    <>
      <!-- Spotlight -->
      <section class="events-spotlight">
        {spotlight ? (
          <div class="spotlight-inner">
            <div class="spotlight-img-wrap">
              <img
                src={`/events/images/${spotlight.Image}`}
                alt={spotlight.Name}
                class="spotlight-img"
                loading="eager"
              />
            </div>
            <div class="spotlight-info">
              <span class="spotlight-eyebrow">Next Up</span>
              <h2 class="spotlight-name">{spotlight.Name}</h2>
              <ul class="spotlight-meta-list">
                <li class="spotlight-meta">
                  <span class="meta-icon">📅</span>
                  <span>{spotlight.Date}</span>
                </li>
                <li class="spotlight-meta">
                  <span class="meta-icon">🕐</span>
                  <span>{spotlight.Time}</span>
                </li>
                <li class="spotlight-meta">
                  <span class="meta-icon">📍</span>
                  <a
                    href={mapsUrl(spotlight.Location)}
                    class="spotlight-location-link"
                    target="_blank"
                    rel="noopener"
                  >{spotlight.Location}</a>
                </li>
              </ul>
              {spotlight.Desc && <p class="spotlight-bio">{spotlight.Desc}</p>}
              <div class="spotlight-actions">
                {spotlight.CalendarLink ? (
                  <a
                    href={spotlight.CalendarLink}
                    class="spotlight-cal-btn"
                    target="_blank"
                    rel="noopener"
                  >+ Add to Calendar</a>
                ) : (
                  <button class="spotlight-cal-btn is-disabled" disabled>+ Add to Calendar</button>
                )}
                <a href={`/events/${spotlight.slug}`} class="spotlight-more-btn">
                  View Details →
                </a>
              </div>
            </div>
          </div>
        ) : (
          <div class="spotlight-empty">
            <p class="spotlight-empty-title">No Upcoming Events</p>
            <p class="spotlight-empty-sub">Check back soon — something is always in the works.</p>
          </div>
        )}
      </section>

      <!-- Carousel -->
      <section class="events-carousel-section">
        <div class="carousel-header">
          <h2 class="carousel-title">All Events</h2>
          <div class="carousel-arrows">
            <button class="carousel-arrow" id="carouselPrev" aria-label="Previous events">&#8592;</button>
            <button class="carousel-arrow" id="carouselNext" aria-label="Next events">&#8594;</button>
          </div>
        </div>
        <div class="carousel-viewport" id="carouselViewport">
          <div class="carousel-track" id="carouselTrack">
            {sorted.map((ev) => (
              <div class="carousel-card" data-slug={ev.slug}>
                <div class="carousel-img-wrap">
                  <img
                    src={`/events/images/${ev.Image}`}
                    alt={ev.Name}
                    class="carousel-img"
                    loading="lazy"
                    width="400"
                    height="300"
                  />
                </div>
                <div class="carousel-info">
                  <p class="carousel-name">{ev.Name}</p>
                  <p class="carousel-meta">📅 {ev.Date}</p>
                  <p class="carousel-meta">🕐 {ev.Time}</p>
                  <p class="carousel-meta">
                    <a
                      href={mapsUrl(ev.Location)}
                      class="location-pin-link"
                      target="_blank"
                      rel="noopener"
                    >📍 {ev.Location}</a>
                  </p>
                  <div class="carousel-cal-wrap">
                    {ev.CalendarLink ? (
                      <a
                        href={ev.CalendarLink}
                        class="event-cal-btn"
                        target="_blank"
                        rel="noopener"
                      >+ Add to Calendar</a>
                    ) : (
                      <button class="event-cal-btn is-disabled" disabled>+ Add to Calendar</button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Calendar -->
      <section class="events-calendar-section">
        <div class="cal-header">
          <button class="cal-nav-btn" id="calPrev" aria-label="Previous month">&#8592;</button>
          <h2 class="cal-month-label" id="calMonthLabel"></h2>
          <button class="cal-nav-btn" id="calNext" aria-label="Next month">&#8594;</button>
        </div>
        <div class="cal-grid-wrap">
          <div class="cal-dow-row">
            {["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].map((d) => (
              <div class="cal-dow">{d}</div>
            ))}
          </div>
          <div class="cal-grid" id="calGrid"></div>
        </div>
      </section>
    </>
  )}

</BaseLayout>

<script define:vars={{ calEventsData, spotlightIndex }}>
  // ── Carousel ────────────────────────────────────────────────────────────
  const viewport = document.getElementById("carouselViewport");
  const track    = document.getElementById("carouselTrack");
  const prevBtn  = document.getElementById("carouselPrev");
  const nextBtn  = document.getElementById("carouselNext");

  if (track && viewport && prevBtn && nextBtn) {
    const cards = Array.from(track.querySelectorAll(".carousel-card"));
    let index = spotlightIndex;

    function visibleCount() {
      if (window.innerWidth >= 900) return 3;
      if (window.innerWidth >= 560) return 2;
      return 1;
    }

    function render() {
      const vis   = visibleCount();
      const gap   = parseFloat(getComputedStyle(track).columnGap) || 32;
      const vpW   = viewport.offsetWidth;
      const cardW = (vpW - gap * (vis - 1)) / vis;
      const max   = Math.max(0, cards.length - vis);

      index = Math.min(index, max);

      cards.forEach((c) => {
        c.style.width      = cardW + "px";
        c.style.flexShrink = "0";
      });

      track.style.transform = `translateX(-${index * (cardW + gap)}px)`;
      prevBtn.disabled = index === 0;
      nextBtn.disabled = index >= max;
    }

    prevBtn.addEventListener("click", () => {
      index = Math.max(0, index - 1);
      render();
    });
    nextBtn.addEventListener("click", () => {
      index = Math.min(Math.max(0, cards.length - visibleCount()), index + 1);
      render();
    });

    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        if (e.target.closest("a, button")) return;
        window.location.href = "/events/" + card.dataset.slug;
      });
    });

    window.addEventListener("resize", render);
    render();
  }

  // ── Calendar ────────────────────────────────────────────────────────────
  const calGrid   = document.getElementById("calGrid");
  const calLabel  = document.getElementById("calMonthLabel");
  const calPrevEl = document.getElementById("calPrev");
  const calNextEl = document.getElementById("calNext");

  if (calGrid && calLabel) {
    const MONTHS = [
      "January","February","March","April","May","June",
      "July","August","September","October","November","December"
    ];

    const eventsWithDates = calEventsData.map((e) => ({
      ...e,
      _date: new Date(e.date),
    }));

    const now = new Date();
    let viewYear  = now.getFullYear();
    let viewMonth = now.getMonth();

    function build() {
      calLabel.textContent = `${MONTHS[viewMonth]} ${viewYear}`;
      calGrid.innerHTML = "";

      const firstDay    = new Date(viewYear, viewMonth, 1).getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      const todayDate   = new Date();

      for (let i = 0; i < firstDay; i++) {
        const blank = document.createElement("div");
        blank.className = "cal-cell cal-cell--empty";
        calGrid.appendChild(blank);
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const cell = document.createElement("div");
        cell.className = "cal-cell";

        const num = document.createElement("span");
        num.className = "cal-day-num";
        num.textContent = String(d);

        const isToday =
          d === todayDate.getDate() &&
          viewMonth === todayDate.getMonth() &&
          viewYear  === todayDate.getFullYear();
        if (isToday) num.classList.add("cal-today");

        cell.appendChild(num);

        eventsWithDates
          .filter((e) => {
            const ed = e._date;
            return ed.getFullYear() === viewYear &&
                   ed.getMonth()    === viewMonth &&
                   ed.getDate()     === d;
          })
          .forEach((ev) => {
            const chip = document.createElement("a");
            chip.href = "/events/" + ev.slug;
            chip.className = "cal-event-chip";
            chip.textContent = window.innerWidth < 560
              ? ev.name
              : (ev.time ? ev.time + " · " : "") + ev.name;
            chip.title = ev.name;
            cell.appendChild(chip);
          });

        calGrid.appendChild(cell);
      }
    }

    calPrevEl?.addEventListener("click", () => {
      viewMonth--;
      if (viewMonth < 0) { viewMonth = 11; viewYear--; }
      build();
    });
    calNextEl?.addEventListener("click", () => {
      viewMonth++;
      if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      build();
    });

    build();
  }
</script>