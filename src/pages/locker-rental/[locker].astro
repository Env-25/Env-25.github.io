---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLockers, getLockerBySlug } from "../../utils/lockers";
import "../../styles/locker-rental.css";

export async function getStaticPaths() {
  return getLockers().map((l) => ({ params: { locker: l.slug } }));
}

const { locker: slug } = Astro.params;
const locker = getLockerBySlug(slug!);
if (!locker) return Astro.redirect("/locker-rental");

const allImages = [locker.Cover_photo, ...locker.Add_photos];
const toCm = (i: number) => (i * 2.54).toFixed(1);

const levels = [
  { label: "Top",    count: locker.Availability_Top },
  { label: "Mid",    count: locker.Availability_Mid },
  { label: "Bottom", count: locker.Availability_Bottom },
];
---
<BaseLayout title={`${locker.Name} — CHBE Locker Rental`} hideNav={true}>
  <div class="item-topnav">
    <a href="/locker-rental" class="topnav-btn">← Back to Lockers</a>
    <a href="/" class="topnav-btn">Home</a>
  </div>

  <div class="locker-item-page">

    <!-- Breadcrumb -->
    <nav class="item-breadcrumb">
      <a href="/locker-rental">Lockers</a>
      <span>›</span>
      <span>{locker.Location}</span>
      <span>›</span>
      <span>{locker.Name}</span>
    </nav>

    <div class="item-layout">

      <!-- Gallery -->
      <div class="item-gallery">
        <div class="gallery-thumbs">
          {allImages.map((img, i) => (
            <button class={`thumb-btn${i === 0 ? " active" : ""}`} data-img={`/lockers/images/${img}`} aria-label={`View ${i + 1}`}>
              <img src={`/lockers/images/${img}`} alt={`${locker.Name} view ${i + 1}`} loading="lazy" />
            </button>
          ))}
        </div>
        <div class="gallery-main">
          <img id="mainImage" src={`/lockers/images/${locker.Cover_photo}`} alt={locker.Name} class="gallery-main-img" />
        </div>
      </div>

      <!-- Info -->
      <div class="item-info">
        <p class="item-location">{locker.Location}</p>
        <h1 class="item-name">{locker.Name}</h1>

        <div class="item-meta-row">
          <p class="item-price">
            ${locker.Price.toFixed(2)}
            <span class="item-price-note">CAD / {locker.Rental_Term === "Semester" ? "sem" : "yr"}</span>
          </p>
          <span class={`avail-tag-large ${locker.totalAvailable > 0 ? "avail" : "rented"}`}>
            {locker.totalAvailable > 0 ? `${locker.totalAvailable} Available` : "Fully Rented"}
          </span>
        </div>

        <div class="item-divider"></div>
        <p class="item-desc">{locker.Desc}</p>
        <div class="item-divider"></div>

        <!-- Specs -->
        <div class="item-specs">
          <div class="spec-row">
            <span class="spec-key">Size</span>
            <span class="spec-val">
              {locker.Size} in &nbsp;·&nbsp;
              {toCm(locker.width)} × {toCm(locker.height)} × {toCm(locker.depth)} cm
            </span>
          </div>
          <div class="spec-row">
            <span class="spec-key">Building</span>
            <span class="spec-val">{locker.Location}</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">Rental Term</span>
            <span class="spec-val">{locker.Rental_Term}</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">Lock Included</span>
            <span class="spec-val">{locker.Lock_Included ? "✓ Yes" : "✗ No — bring your own"}</span>
          </div>
        </div>

        <div class="item-divider"></div>

        <!-- Level selector -->
        <div class="level-avail-block">
          <p class="option-label">
            Level
            <span class="option-label-hint" id="levelSelectedLabel"></span>
          </p>
          <div class="level-btn-group" id="levelBtnGroup">
            {levels.map(({ label, count }) => (
              // ✅ FIX 1: class-based, never disabled={...} — Astro renders
              //           disabled="false" which HTML treats as truthy
              <button
                class={`level-select-btn${count === 0 ? " is-full" : ""}`}
                data-level={label}
                data-count={count}
                title={count === 0 ? "None available" : `${count} left`}
              >
                <span class="level-select-name">{label}</span>
                <span class={`level-select-count ${count > 0 ? "open" : "full"}`}>
                  {count > 0 ? `${count} left` : "Full"}
                </span>
              </button>
            ))}
          </div>
        </div>

        <div class="item-divider"></div>

        <!-- Reserve button -->
        <button class="purchase-btn" id="reserveBtn" disabled type="button">
          {locker.totalAvailable > 0 ? "Select a level to add" : "Currently Fully Rented"}
        </button>
        <p class="purchase-note" id="reserveNote">
          {locker.totalAvailable > 0 ? "Select a level, then add to cart." : "Online reservations unavailable."}
        </p>

        <div class="item-divider"></div>

        <!-- Size guide -->
        <details class="size-chart">
          <summary>Size guide</summary>
          <p class="size-chart-intro">All dimensions are Width × Height × Depth.</p>
          <table class="size-table">
            <thead>
              <tr><th>Size (in)</th><th>Width</th><th>Height</th><th>Depth</th></tr>
            </thead>
            <tbody>
              {["8x12x24","10x12x18","12x18x18","12x18x24","14x20x30"].map((s) => {
                const [w,h,d] = s.split("x").map(Number);
                return (
                  <tr class={locker.Size === s ? "size-row-active" : ""}>
                    <td>{s}</td>
                    <td>{w} in / {(w*2.54).toFixed(1)} cm</td>
                    <td>{h} in / {(h*2.54).toFixed(1)} cm</td>
                    <td>{d} in / {(d*2.54).toFixed(1)} cm</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ locker }}>
  window.__CHBE_LOCKER__ = locker;
</script>

<script>
  import { addToCart, fetchInventoryStock, inventorySku } from "../../utils/cart";

  let controller = null;

  async function applyLiveStock(locker, levelBtns) {
    const levels = ["Top", "Mid", "Bottom"];
    const skus = levels.map((level) =>
      inventorySku({ kind: "locker", id: locker.ID, level })
    );
    const stock = await fetchInventoryStock(skus);
    let total = 0;

    levelBtns.forEach((btn) => {
      const level = btn.dataset.level || "";
      const sku = inventorySku({ kind: "locker", id: locker.ID, level });
      const count = Object.prototype.hasOwnProperty.call(stock, sku)
        ? Math.max(0, Number(stock[sku]) || 0)
        : Math.max(0, parseInt(btn.dataset.count || "0", 10));
      btn.dataset.count = String(count);
      total += count;
      const isFull = count === 0;
      btn.classList.toggle("is-full", isFull);
      btn.classList.toggle("selected", false);
      btn.title = isFull ? "None available" : `${count} left`;
      const countEl = btn.querySelector(".level-select-count");
      if (countEl) {
        countEl.className = `level-select-count ${count > 0 ? "open" : "full"}`;
        countEl.textContent = count > 0 ? `${count} left` : "Full";
      }
    });

    const availTag = document.querySelector(".avail-tag-large");
    if (availTag) {
      availTag.className = `avail-tag-large ${total > 0 ? "avail" : "rented"}`;
      availTag.textContent = total > 0 ? `${total} Available` : "Fully Rented";
    }

    return total;
  }

  function init() {
    const locker = window.__CHBE_LOCKER__;
    if (!locker) return;

    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const thumbBtns = document.querySelectorAll(".thumb-btn");
    const mainImg = document.getElementById("mainImage");

    thumbBtns.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          thumbBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          if (mainImg) mainImg.src = btn.dataset.img;
        },
        { signal }
      );
    });

    const levelBtns = document.querySelectorAll(".level-select-btn");
    const reserveBtn = document.getElementById("reserveBtn");
    const levelSelectedLabel = document.getElementById("levelSelectedLabel");
    const reserveNote = document.getElementById("reserveNote");
    let selectedLevel = "";

    levelBtns.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          if (parseInt(btn.dataset.count || "0", 10) <= 0) return;
          levelBtns.forEach((b) => b.classList.remove("selected"));
          btn.classList.add("selected");

          selectedLevel = btn.dataset.level || "";
          if (levelSelectedLabel) levelSelectedLabel.textContent = `— ${selectedLevel}`;
          if (reserveBtn) {
            reserveBtn.disabled = false;
            reserveBtn.textContent = `Add ${selectedLevel} Level to Cart`;
          }
          if (reserveNote) reserveNote.textContent = "";
        },
        { signal }
      );
    });

    reserveBtn?.addEventListener(
      "click",
      () => {
        if (reserveBtn.disabled || !selectedLevel) return;
        addToCart({
          kind: "locker",
          id: locker.ID,
          slug: locker.slug,
          name: locker.Name,
          image: `/lockers/images/${locker.Cover_photo}`,
          level: selectedLevel,
          location: locker.Location,
          qty: 1,
          unitPrice: locker.Price,
        });
        reserveBtn.textContent = "Added ✓";
        if (reserveNote) {
          reserveNote.innerHTML = `Added to cart. <a href="/cart">View cart</a>`;
        }
        setTimeout(() => {
          reserveBtn.textContent = `Add ${selectedLevel} Level to Cart`;
        }, 1200);
      },
      { signal }
    );

    applyLiveStock(locker, levelBtns).then((total) => {
      selectedLevel = "";
      if (levelSelectedLabel) levelSelectedLabel.textContent = "";
      if (reserveBtn) {
        if (total > 0) {
          reserveBtn.disabled = true;
          reserveBtn.textContent = "Select a level to add";
          if (reserveNote) reserveNote.textContent = "Select a level, then add to cart.";
        } else {
          reserveBtn.disabled = true;
          reserveBtn.textContent = "Currently Fully Rented";
          if (reserveNote) reserveNote.textContent = "Online reservations unavailable.";
        }
      }
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) init();
  });
</script>
