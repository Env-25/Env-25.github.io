---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMerch, getMerchBySlug, colorToCSS } from "../../utils/merch";
import "../../styles/merch-item.css";

export async function getStaticPaths() {
  const items = getMerch();
  return items.map((item) => ({ params: { item: item.slug } }));
}

const { item: slug } = Astro.params;
const product = getMerchBySlug(slug!);
if (!product) return Astro.redirect("/merch");

const hasColors = product.colorVariants.length > 1;
const cardPrice = (product.Price * 1.03).toFixed(2);

interface GalleryImage {
  src: string;
  color: string;
  variantSlug: string;
  isCover: boolean;
}

const galleryImages: GalleryImage[] = product.colorVariants.flatMap((v) => [
  { src: v.cover_image, color: v.color, variantSlug: v.slug, isCover: true },
  ...v.additional_images.map((img) => ({
    src: img,
    color: v.color,
    variantSlug: v.slug,
    isCover: false,
  })),
]);

const activeColor = product.Color;
const activeVariant =
  product.colorVariants.find((v) => v.color === activeColor) ?? product.colorVariants[0];

const activeSizes = activeVariant?.sizesStock ?? [];
const firstImage = activeVariant?.cover_image ?? product.Cover_image;
---

<BaseLayout title={`${product.Name} — CHBE Merch`} hideNav={true}>
  <div class="item-topnav">
    <a href="/merch" class="topnav-btn">← Back to Merch</a>
    <a href="/" class="topnav-btn">Home</a>
  </div>

  <div class="item-page">
    <nav class="item-breadcrumb">
      <a href="/merch">Merch</a>
      <span>›</span>
      <span>{product.Type}</span>
      <span>›</span>
      <span>{product.Name}</span>
    </nav>

    <div class="item-layout">
      <div class="item-gallery">
        <div class="gallery-thumbs" id="galleryThumbs">
          {product.colorVariants.map((v) => {
            const variantImgs: GalleryImage[] = galleryImages.filter((g) => g.color === v.color);
            return (
              <div
                class={`thumb-group${v.color === activeColor ? " active-group" : ""}`}
                data-group-color={v.color}
              >
                {variantImgs.map((img, idx) => (
                  <button
                    class={`thumb-btn${img.isCover && v.color === activeColor ? " active" : ""}`}
                    data-img={`/merch/images/${img.src}`}
                    data-color={v.color}
                    aria-label={`${v.color} view ${idx + 1}`}
                    type="button"
                  >
                    <img
                      src={`/merch/images/${img.src}`}
                      alt={`${product.Name} — ${v.color} view ${idx + 1}`}
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
            );
          })}
        </div>

        <div class="gallery-main">
          <img
            id="mainImage"
            src={`/merch/images/${firstImage}`}
            alt={product.Name}
            class="gallery-main-img"
          />
        </div>
      </div>

      <div class="item-info">
        <p class="item-type">{product.Type}</p>
        <h1 class="item-name">{product.Name}</h1>

        <div class="item-price-row">
          <span class="item-price-cash">
            <img src="/logos/cash.png" alt="Cash price" class="item-price-icon" />
            ${product.Price.toFixed(2)}
            <span class="item-price-note">CAD</span>
          </span>
          <span class="item-price-sep">·</span>
          <span class="item-price-card">
            <svg class="item-price-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
              <line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            ${cardPrice}
            <span class="item-price-note">incl. 3% Card Surcharge</span>
          </span>
        </div>

        <div class="item-divider"></div>

        {product.Desc && <p class="item-desc">{product.Desc}</p>}
        {product.Desc && <div class="item-divider"></div>}

        <input
          type="hidden"
          id="selectedColorInput"
          name="selected_color"
          value={activeColor}
        />

        <div class="item-option-block">
          <p class="option-label">
            Colour
            <span class="selected-value" id="selectedColorLabel">— {activeColor}</span>
          </p>
          <div class="color-btn-group" id="colorGroup">
            {product.colorVariants.map((v) => (
              <button
                class={`color-variant-btn${v.color === activeColor ? " active" : ""}${!v.inStock ? " out" : ""}`}
                data-color={v.color}
                data-slug={v.slug}
                title={v.inStock ? v.color : `${v.color} — sold out`}
                aria-label={v.color}
                type="button"
              >
                <span
                  class="color-variant-dot"
                  style={`background:${colorToCSS(v.color)}`}
                ></span>
                <span class="color-variant-name">{v.color}</span>
                {!v.inStock && <span class="color-variant-out">sold out</span>}
              </button>
            ))}
          </div>
        </div>

        <div class="item-option-block">
          <p class="option-label">
            Size <span id="selectedSizeLabel" class="selected-value"></span>
          </p>
          <div class="size-btn-group" id="sizeGroup">
            {activeSizes.map(({ size, stock }) => (
              <button
                class={`size-btn${stock === 0 ? " out" : ""}`}
                data-size={size}
                data-stock={stock}
                disabled={stock === 0}
                title={stock === 0 ? "Out of stock" : `${stock} left`}
                type="button"
              >
                {size}
              </button>
            ))}
          </div>
        </div>

        <div class="item-option-block" id="qtyBlock" style="display:none">
          <p class="option-label">Quantity</p>
          <div class="qty-row">
            <button class="qty-btn" id="qtyDown" type="button">−</button>
            <span class="qty-value" id="qtyValue">1</span>
            <button class="qty-btn" id="qtyUp" type="button">+</button>
            <span class="qty-stock-note" id="qtyStockNote"></span>
          </div>
        </div>

        <button class="purchase-btn" id="purchaseBtn" disabled type="button">
          Select a size to purchase
        </button>
        <p class="purchase-note">Purchases coming soon — stay tuned!</p>

        <div class="item-divider"></div>

        {product.allSizes.some((s) => ["XS", "S", "M", "L", "XL", "XXL"].includes(s)) && (
          <details class="size-chart">
            <summary>Size guide</summary>
            <table class="size-table">
              <thead><tr><th>Size</th><th>Chest (in)</th><th>Length (in)</th></tr></thead>
              <tbody>
                <tr><td>XS</td><td>32–34</td><td>26</td></tr>
                <tr><td>S</td><td>35–37</td><td>27</td></tr>
                <tr><td>M</td><td>38–40</td><td>28</td></tr>
                <tr><td>L</td><td>41–43</td><td>29</td></tr>
                <tr><td>XL</td><td>44–46</td><td>30</td></tr>
                <tr><td>XXL</td><td>47–49</td><td>31</td></tr>
              </tbody>
            </table>
          </details>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ product }}>
  const thumbBtns = Array.from(document.querySelectorAll(".thumb-btn"));
  const thumbGroups = Array.from(document.querySelectorAll(".thumb-group"));
  const mainImg = document.getElementById("mainImage");

  const colorBtns = Array.from(document.querySelectorAll(".color-variant-btn"));
  const colorLabel = document.getElementById("selectedColorLabel");
  const colorInput = document.getElementById("selectedColorInput");

  const sizeBtns = Array.from(document.querySelectorAll(".size-btn"));
  const selectedSizeLabel = document.getElementById("selectedSizeLabel");
  const qtyBlock = document.getElementById("qtyBlock");
  const qtyValue = document.getElementById("qtyValue");
  const qtyStockNote = document.getElementById("qtyStockNote");
  const qtyDown = document.getElementById("qtyDown");
  const qtyUp = document.getElementById("qtyUp");
  const purchaseBtn = document.getElementById("purchaseBtn");

  let selectedStock = 0;
  let qty = 1;

  function activateThumb(btn) {
    thumbBtns.forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    if (mainImg) mainImg.src = btn.dataset.img;
  }

  function setSizesForColor(color) {
    const variant = product.colorVariants.find((v) => v.color === color);
    if (!variant) return;

    sizeBtns.forEach((btn) => {
      const size = btn.dataset.size;
      const entry = variant.sizesStock.find((s) => s.size === size);
      const stock = entry ? entry.stock : 0;

      btn.dataset.stock = String(stock);
      btn.disabled = stock === 0;
      btn.classList.toggle("out", stock === 0);
      btn.title = stock === 0 ? "Out of stock" : `${stock} left`;
      btn.classList.remove("active");
    });

    selectedSizeLabel.textContent = "";
    qtyBlock.style.display = "none";
    qtyValue.textContent = "1";
    qtyStockNote.textContent = "";
    qtyDown.disabled = true;
    qtyUp.disabled = true;
    purchaseBtn.disabled = true;
    purchaseBtn.textContent = "Select a size to purchase";
  }

  function selectColor(color) {
    if (!color) return;

    colorLabel.textContent = `— ${color}`;
    if (colorInput) colorInput.value = color;

    colorBtns.forEach((b) => b.classList.toggle("active", b.dataset.color === color));
    thumbGroups.forEach((g) => g.classList.toggle("active-group", g.dataset.groupColor === color));

    setSizesForColor(color);

    const firstThumb = thumbBtns.find((b) => b.dataset.color === color);
    if (firstThumb) {
      activateThumb(firstThumb);
      firstThumb.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }

  thumbBtns.forEach((btn) => {
    btn.addEventListener("click", () => activateThumb(btn));
  });

  colorBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!btn.classList.contains("out")) selectColor(btn.dataset.color);
    });
  });

  sizeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.disabled) return;

      sizeBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      selectedStock = parseInt(btn.dataset.stock || "0", 10);
      qty = 1;

      selectedSizeLabel.textContent = `— ${btn.dataset.size}`;
      qtyValue.textContent = "1";
      qtyStockNote.textContent = `${selectedStock} in stock`;
      qtyBlock.style.display = "";
      qtyDown.disabled = true;
      qtyUp.disabled = selectedStock <= 1;
      purchaseBtn.disabled = true;
      purchaseBtn.textContent = "Purchase (Coming Soon)";
    });
  });

  qtyDown?.addEventListener("click", () => {
    if (qty > 1) {
      qty -= 1;
      qtyValue.textContent = String(qty);
      qtyDown.disabled = qty <= 1;
      qtyUp.disabled = qty >= selectedStock;
    }
  });

  qtyUp?.addEventListener("click", () => {
    if (qty < selectedStock) {
      qty += 1;
      qtyValue.textContent = String(qty);
      qtyDown.disabled = qty <= 1;
      qtyUp.disabled = qty >= selectedStock;
    }
  });

  const initialColor =
    colorInput?.value ||
    product.Color ||
    product.colorVariants[0]?.color ||
    "";

  selectColor(initialColor);

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      selectColor(colorInput?.value || initialColor);
    }
  });
</script>