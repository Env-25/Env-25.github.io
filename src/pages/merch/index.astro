---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getGroupedMerch,
  getMerchTypes,
  getMerchSizes,
  getMerchColors,
  colorToCSS,
} from "../../utils/merch";
import "../../styles/merch.css";

const items = getGroupedMerch();
const types = getMerchTypes();
const sizes = getMerchSizes();
const colors = getMerchColors();
const maxPrice = 130;
---

<BaseLayout title="Merch — UBC CHBE">
  <section class="merch-hero">
    <img src="/home/index-lower.jpg" alt="" class="merch-hero-bg" />
    <div class="merch-hero-overlay"></div>
    <div class="merch-hero-content">
      <h1 class="merch-hero-title">CHBE Merch</h1>
      <p class="merch-hero-sub">Rep the department. Wear it with pride.</p>
    </div>
  </section>

  <section class="merch-section">
    <div class="merch-layout">
      <aside class="merch-sidebar" id="merchSidebar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/>
          </svg>
          Filters
          <span class="sidebar-toggle-arrow">▾</span>
        </button>

        <div class="sidebar-collapsible" id="sidebarCollapsible">
          <div class="sidebar-block">
            <p class="sidebar-heading">Search</p>
            <div class="merch-search-inner">
              <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input
                type="search"
                id="merchSearch"
                class="merch-search-input"
                placeholder="Name or type…"
                autocomplete="off"
                spellcheck="false"
              />
              <button class="search-clear" id="searchClear" aria-label="Clear" hidden>✕</button>
            </div>
          </div>

          <div class="sidebar-block">
            <p class="sidebar-heading">Type</p>
            <div class="filter-btn-group" id="typeFilters">
              <button class="filter-btn active" data-type="all">All</button>
              {types.map((t) => (
                <button class="filter-btn" data-type={t}>{t}</button>
              ))}
            </div>
          </div>

          <div class="sidebar-block">
            <p class="sidebar-heading">Size</p>
            <div class="filter-btn-group" id="sizeFilters">
              <button class="filter-btn active" data-size="all">All</button>
              {sizes.map((s) => (
                <button class="filter-btn" data-size={s}>{s}</button>
              ))}
            </div>
          </div>

          {colors.length > 0 && (
            <div class="sidebar-block">
              <p class="sidebar-heading">Colour</p>
              <div class="filter-btn-group" id="colorFilters">
                <button class="filter-btn active" data-color="all">All</button>
                {colors.map((c) => (
                  <button
                    class="filter-btn filter-btn--color"
                    data-color={c}
                    style={`--swatch-clr: ${colorToCSS(c)}`}
                  >
                    <span class="filter-btn-swatch"></span>{c}
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="sidebar-block">
            <p class="sidebar-heading">Price Range</p>
            <div class="price-slider-wrap">
              <div class="price-display">
                <span id="priceMinLabel">$0</span>
                <span id="priceMaxLabel">${maxPrice}</span>
              </div>
              <div class="dual-slider-track" id="sliderTrack">
                <div class="dual-slider-fill" id="sliderFill"></div>
                <input type="range" id="priceMin" class="dual-range" min="0" max={maxPrice} value="0" step="1" />
                <input type="range" id="priceMax" class="dual-range" min="0" max={maxPrice} value={maxPrice} step="1" />
              </div>
            </div>
          </div>

          <div class="sidebar-block">
            <label class="stock-toggle">
              <input type="checkbox" id="inStockOnly" />
              <span class="stock-toggle-label">In stock only</span>
            </label>
          </div>

          <button class="sidebar-reset" id="resetFilters">Reset all filters</button>
        </div>
      </aside>

      <div class="merch-main">

        <div class="merch-grid" id="merchGrid">
          {items.map((item) => {
            const allColors = item.colorVariants.map((v) => v.color).filter(Boolean);
            const colourCount = allColors.length;

            const inStockSizes = item.Sizes_Stock.filter((s) => s.stock > 0).map((s) => s.size);
            const anyVariantInStock = item.inStock;

            return (
              <div
                class="merch-card"
                data-name={item.Name}
                data-type={item.Type}
                data-sizes={inStockSizes.join(",")}
                data-variants={JSON.stringify(
                item.colorVariants.map((v) => ({
                  color: v.color,
                  inStock: v.inStock,
                  sizes: v.sizesStock.filter((s) => s.stock > 0).map((s) => s.size),
                }))
              )}
                data-instock={anyVariantInStock ? "true" : "false"}
                data-price={item.Price}
                data-colors={allColors.join(",")}
              >
                <a href={`/merch/${item.slug}`} class="merch-card-link">
                  <div class="merch-card-img-wrap">
                    {!anyVariantInStock && <span class="sold-out-badge">Sold Out</span>}
                    <img
                      src={`/merch/images/${item.Cover_image}`}
                      alt={item.Name}
                      class="merch-card-img"
                      loading="lazy"
                    />
                  </div>

                  <div class="merch-card-info">
                    <p class="merch-card-type">{item.Type}</p>
                    <p class="merch-card-name">{item.Name}</p>

                    <div class="merch-card-pricing">
                      <span class="price-cash">
                        <img src="/logos/cash.png" alt="Cash price" class="price-icon" />
                        ${item.Price.toFixed(2)}
                      </span>
                      <span class="price-card">
                        <svg class="price-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                          <line x1="1" y1="10" x2="23" y2="10"/>
                        </svg>
                        ${(item.Price * 1.03).toFixed(2)}
                      </span>
                    </div>

                    {inStockSizes.length > 0 && (
                      <div class="merch-card-sizes">
                        {inStockSizes.map((s) => <span class="size-pip">{s}</span>)}
                      </div>
                    )}

                    <div class="merch-card-color-hint">
                      <span class="color-hint-dots">
                        {allColors.slice(0, 6).map((c) => (
                          <span
                            class="color-mini-dot"
                            style={`background:${colorToCSS(c)}`}
                            title={c}
                          ></span>
                        ))}
                        {colourCount > 6 && (
                          <span class="color-mini-more">+{colourCount - 6}</span>
                        )}
                      </span>
                      <span class="color-hint-text">
                        {colourCount} colour{colourCount !== 1 ? "s" : ""}
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>

        <p class="no-results" id="noResults" hidden>No items match your filters.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import Fuse from "fuse.js";

  const grid = document.getElementById("merchGrid");
  const cards = Array.from(grid.querySelectorAll(".merch-card"));

  const data = cards.map((card) => ({
    el: card,
    name: card.dataset.name ?? "",
    type: card.dataset.type ?? "",
    sizes: (card.dataset.sizes ?? "").split(",").filter(Boolean),
    inStock: card.dataset.instock === "true",
    price: parseFloat(card.dataset.price ?? "0"),
    colors: (card.dataset.colors ?? "").split(",").filter(Boolean),
    variants: JSON.parse(card.dataset.variants ?? "[]"),
  }));

  const fuse = new Fuse(data, {
    keys: [
      { name: "name", weight: 0.65 },
      { name: "type", weight: 0.35 },
    ],
    threshold: 0.35,
    includeScore: true,
  });

  let activeType = "all";
  let activeSize = "all";
  let activeColor = "all";
  let inStockOnly = false;
  let priceMin = 0;
  let priceMax = 130;

  const searchInput = document.getElementById("merchSearch");
  const searchClear = document.getElementById("searchClear");
  const typeButtons = document.querySelectorAll("[data-type]");
  const sizeButtons = document.querySelectorAll("[data-size]");
  const colorButtons = document.querySelectorAll("[data-color]");
  const inStockCheck = document.getElementById("inStockOnly");
  const priceMinEl = document.getElementById("priceMin");
  const priceMaxEl = document.getElementById("priceMax");
  const priceMinLabel = document.getElementById("priceMinLabel");
  const priceMaxLabel = document.getElementById("priceMaxLabel");
  const sliderFill = document.getElementById("sliderFill");
  const noResults = document.getElementById("noResults");
  const resetBtn = document.getElementById("resetFilters");

  function updateSliderFill() {
    const min = parseInt(priceMinEl.value, 10);
    const max = parseInt(priceMaxEl.value, 10);
    const range = parseInt(priceMinEl.max, 10) - parseInt(priceMinEl.min, 10);
    sliderFill.style.left = `${(min / range) * 100}%`;
    sliderFill.style.right = `${100 - (max / range) * 100}%`;
  }

  function applyFilters() {
    const q = searchInput.value.trim();
    searchClear.hidden = q.length === 0;

    const textMatched = q
      ? new Set(fuse.search(q).map((r) => r.item.el))
      : null;

    let visible = 0;

    data.forEach(({ el, inStock, price, variants }) => {
      const passText = textMatched === null || textMatched.has(el);
      const passType = activeType === "all" || el.dataset.type === activeType;
      const passPrice = price >= priceMin && price <= priceMax;

      let matchingVariants = variants;

      if (activeColor !== "all") {
        matchingVariants = matchingVariants.filter((v) => v.color === activeColor);
      }

      if (activeSize !== "all") {
        matchingVariants = matchingVariants.filter((v) => v.sizes.includes(activeSize));
      }

      const passVariantMatch =
        activeColor === "all" && activeSize === "all"
          ? true
          : matchingVariants.length > 0;

      const passStock =
        !inStockOnly ||
        (activeColor === "all" && activeSize === "all"
          ? inStock
          : matchingVariants.some((v) => v.inStock));

      el.hidden = !(passText && passType && passPrice && passVariantMatch && passStock);
    });

    noResults.hidden = visible > 0;

    const anyFilter =
      q ||
      activeType !== "all" ||
      activeSize !== "all" ||
      activeColor !== "all" ||
      inStockOnly ||
      priceMin > 0 ||
      priceMax < 130;
  }

  typeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      typeButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeType = btn.dataset.type;
      applyFilters();
    });
  });

  sizeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      sizeButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeSize = btn.dataset.size;
      applyFilters();
    });
  });

  colorButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      colorButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeColor = btn.dataset.color;
      applyFilters();
    });
  });

  priceMinEl.addEventListener("input", () => {
    let min = parseInt(priceMinEl.value, 10);
    let max = parseInt(priceMaxEl.value, 10);
    if (min > max - 1) {
      min = max - 1;
      priceMinEl.value = String(min);
    }
    priceMin = min;
    priceMinLabel.textContent = `$${min}`;
    updateSliderFill();
    applyFilters();
  });

  priceMaxEl.addEventListener("input", () => {
    let min = parseInt(priceMinEl.value, 10);
    let max = parseInt(priceMaxEl.value, 10);
    if (max < min + 1) {
      max = min + 1;
      priceMaxEl.value = String(max);
    }
    priceMax = max;
    priceMaxLabel.textContent = `$${max}`;
    updateSliderFill();
    applyFilters();
  });

  inStockCheck.addEventListener("change", () => {
    inStockOnly = inStockCheck.checked;
    applyFilters();
  });

  searchInput.addEventListener("input", applyFilters);

  searchClear.addEventListener("click", () => {
    searchInput.value = "";
    searchInput.focus();
    applyFilters();
  });

  function resetAllFilters() {
    searchInput.value = "";
    activeType = "all";
    activeSize = "all";
    activeColor = "all";
    inStockOnly = false;
    priceMin = 0;
    priceMax = 130;

    priceMinEl.value = "0";
    priceMaxEl.value = "130";
    priceMinLabel.textContent = "$0";
    priceMaxLabel.textContent = "$130";
    inStockCheck.checked = false;

    typeButtons.forEach((b) => b.classList.toggle("active", b.dataset.type === "all"));
    sizeButtons.forEach((b) => b.classList.toggle("active", b.dataset.size === "all"));
    colorButtons.forEach((b) => b.classList.toggle("active", b.dataset.color === "all"));

    cards.forEach((card) => {
      card.hidden = false;
    });

    noResults.hidden = true;

    updateSliderFill();
    applyFilters();
  }

  resetBtn.addEventListener("click", resetAllFilters);

  updateSliderFill();

  const sidebarToggle = document.getElementById("sidebarToggle");
  const sidebarCollapsible = document.getElementById("sidebarCollapsible");

  sidebarToggle?.addEventListener("click", () => {
    const isOpen = sidebarCollapsible.classList.toggle("is-open");
    sidebarToggle.setAttribute("aria-expanded", String(isOpen));
  });

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      resetAllFilters();
    }
  });
</script>